# MCP Server Configuration
# Host address for the MCP server (0.0.0.0 for all interfaces)
MCP_SERVER_HOST=0.0.0.0

# Port for the MCP server
MCP_SERVER_PORT=3100

# Search engine to use (duckduckgo, serpapi, google)
SEARCH_ENGINE=duckduckgo

# API key for search engine (required for SerpAPI)
# Get your API key from https://serpapi.com/manage-api-key
SEARCH_API_KEY=

# Browser timeout in seconds (for Playwright operations)
BROWSER_TIMEOUT=30

# Maximum number of search results to return
MAX_RESULTS=10

# Enable caching (true/false)
CACHE_ENABLED=true

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# Redis configuration (optional, for distributed caching)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# CORS configuration for MCP clients
# Set to true to allow all origins (development only)
CORS_ALLOW_ALL=false

# Comma-separated list of allowed CORS origins for MCP clients
# Format: http://host1:port1,http://host2:port2
# Default: llama.cpp Web UI (8080), Roo (3000), OpenCode (2280)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:2280
