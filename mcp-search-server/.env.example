# MCP Search Server — Environment Variables
# Copy to .env and fill in as needed.

# Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=3100

# Search engine: duckduckgo | bing | google
SEARCH_ENGINE=duckduckgo
SEARCH_API_KEY=
GOOGLE_CSE_ID=

# Browser
BROWSER_TIMEOUT=30
SCREENSHOT_DIR=/app/mcp-files/screenshots
SESSION_IDLE_TIMEOUT=600

# Results
MAX_RESULTS=10

# Fetch
FETCH_MAX_LENGTH=16000
FETCH_TOKEN_BUDGET=4000
CODE_BLOCK_MAX_CHARS=2000

# File output
FILE_OUTPUT_DIR=/app/mcp-files
FILE_BASE_URL=https://mcp.jessfan.com
MCP_API_KEY=

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ALLOW_ALL=false
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:2280

# Advisor (local LLM)
ADVISOR_BASE_URL=http://localhost:8080/v1
ADVISOR_MODEL=qwen3.6-27b
ADVISOR_API_KEY=
ADVISOR_MAX_TOKENS=8192
