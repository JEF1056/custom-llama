# SGLang Server Configuration
# Copy this file to .env and modify as needed.
# Run: python sync-env.py

# =============================================================================
# SGLang Server
# =============================================================================

SGLANG_HOST=0.0.0.0
SGLANG_PORT=8080

# All requests must include Authorization: Bearer <key>.
SGLANG_API_KEY=

# =============================================================================
# Model
# =============================================================================

# Local directory containing safetensors weights.
SGLANG_MODEL_PATH=/models/qwen3.6-27b-autoround

# Quantization format (auto-round for AutoRound INT4).
SGLANG_QUANTIZATION=auto-round

# Override tokenizer path; leave empty to use the one bundled with the model.
SGLANG_TOKENIZER_PATH=

# Model alias returned by /v1/models and used in chat completion requests.
SGLANG_SERVED_MODEL_NAME=qwen3.6-27b

# =============================================================================
# Inference
# =============================================================================

# Maximum context window in tokens per request.
SGLANG_CONTEXT_LENGTH=145000

# Fraction of GPU VRAM allocated to weights + KV cache (0.0–1.0).
SGLANG_MEM_FRACTION_STATIC=0.97

# Maximum concurrent in-flight requests; 1 = all VRAM to one request's KV cache.
SGLANG_MAX_RUNNING_REQUESTS=1

# Number of GPUs to shard the model across.
SGLANG_TP_SIZE=1

# Weight precision: float16 or bfloat16 (TurboQuant accepts either; casts to fp32 internally).
SGLANG_DTYPE=float16

# KV cache quantization: turboquant, fp8_e5m2, fp8_e4m3, or empty for full-precision.
SGLANG_KV_CACHE_DTYPE=turboquant

# TurboQuant sub-options (only used when KV_CACHE_DTYPE=turboquant).
SGLANG_TURBOQUANT_KEY_BITS=3
SGLANG_TURBOQUANT_VALUE_BITS=2
SGLANG_TURBOQUANT_PROTECTED_LAYERS_HEAD=2
SGLANG_TURBOQUANT_PROTECTED_LAYERS_TAIL=2

# Chunked prefill token budget per batch step.
SGLANG_CHUNKED_PREFILL_SIZE=8192

# Maximum queued requests waiting for a slot; leave empty for unlimited.
SGLANG_MAX_QUEUED_REQUESTS=

# Continuous decode steps between scheduler passes; higher = less scheduler overhead.
SGLANG_NUM_CONTINUOUS_DECODE_STEPS=5

# Mix prefill and decode in the same forward pass for better GPU utilisation (1 to enable).
SGLANG_ENABLE_MIXED_CHUNK=1

# Enable vision/multimodal support; adds ~500 MB–1 GB VRAM for the vision tower.
SGLANG_ENABLE_MULTIMODAL=1

# Reduce CUDA allocator fragmentation under long-context workloads.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:512

# =============================================================================
# Scheduler
# =============================================================================

# Request scheduling: fcfs, lpm (longest-prefix-match), or shortest_job_first.
SGLANG_SCHEDULE_POLICY=fcfs

# =============================================================================
# Sampling
# =============================================================================

# Server-level sampling defaults: model (use model config) or openai (temp=1.0, top_p=1.0).
SGLANG_SAMPLING_DEFAULTS=model

# =============================================================================
# Reasoning Models
# =============================================================================

# Parser for <think>…</think> output extraction: qwen3, deepseek, or empty to disable.
SGLANG_REASONING_PARSER=qwen3

# =============================================================================
# Speculative Decoding
# =============================================================================

# Algorithm: NEXTN (MTP heads, no draft model), NGRAM (n-gram corpus), EAGLE/EAGLE3/DFLASH (separate draft model).
SGLANG_SPECULATIVE_ALGO=NEXTN

# Speculative steps per decode iteration.
SGLANG_SPECULATIVE_NUM_STEPS=3

# Top-k for draft tree branching; 1 = single-path linear (recommended for NEXTN).
SGLANG_SPECULATIVE_EAGLE_TOPK=1

# Maximum draft tokens proposed per step.
SGLANG_SPECULATIVE_NUM_DRAFT_TOKENS=3

# Mamba/DeltaNet scheduler strategy: extra_buffer (required with spec+radix), no_buffer, or auto.
SGLANG_MAMBA_SCHEDULER_STRATEGY=extra_buffer

# Mamba SSM recurrent state precision: float32, bfloat16, or float16.
# float16 matches weight dtype and runs at full tensor core throughput on SM86 (RTX 3090).
SGLANG_MAMBA_SSM_DTYPE=float16

# Fraction of the Mamba state pool reserved for full-state (non-speculative) slots.
SGLANG_MAMBA_FULL_MEMORY_RATIO=0.8

# Hard cap on Mamba recurrent state pool size (slot count); empty = auto-sized.
SGLANG_MAX_MAMBA_CACHE_SIZE=

# =============================================================================
# Model Download
# =============================================================================

# Required for gated/private HuggingFace models.
HF_TOKEN=

# =============================================================================
# Cloudflare Tunnel
# =============================================================================

# Token from Zero Trust → Networks → Tunnels → Create tunnel → Docker.
CF_TUNNEL_TOKEN=

# =============================================================================
# MCP Search Server
# =============================================================================

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=3100

SEARCH_ENGINE=duckduckgo
SEARCH_API_KEY=
BROWSER_TIMEOUT=30
MAX_RESULTS=10
CACHE_ENABLED=true
CACHE_TTL=3600

# Auto-generated by sync-env.py if empty.
MCP_API_KEY=

# Base URL for download links served by the MCP server.
FILE_BASE_URL=https://mcp.jessfan.com

# CORS origins for SGLang (reference only, enforced by Cloudflare Access upstream).
SGLANG_CORS_ORIGINS=*

# CORS origins for the MCP server.
MCP_CORS_ORIGINS=*

# =============================================================================
# Chat UI (ui/ — Vite dev server)
# =============================================================================

# Port the Vite dev server binds on the host.
CHAT_UI_PORT=5173

# Firebase project credentials (from Firebase Console → Project settings → Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated Firebase UIDs allowed to use the chat UI.
VITE_ADMIN_UID=

# =============================================================================
# Logging & Observability
# =============================================================================

# Logging verbosity: debug, info, warning, error.
SGLANG_LOG_LEVEL=info

# Set to 1 to log metadata/inputs/outputs for every request.
SGLANG_LOG_REQUESTS=

# Set to 1 to expose Prometheus metrics at GET /metrics.
SGLANG_ENABLE_METRICS=
