# SGLang Server Configuration
# Copy this file to .env and modify as needed.
# Run: python sync-env.py

# =============================================================================
# SGLang Server
# =============================================================================

SGLANG_HOST=0.0.0.0
SGLANG_PORT=8080

# Optional API key — all requests must include Authorization: Bearer <key>.
SGLANG_API_KEY=

# =============================================================================
# Model
# =============================================================================

# Local directory containing AutoRound INT4 safetensors weights.
# Download first: python scripts/manage_models.py download qwen3.6-27b-autoround
SGLANG_MODEL_PATH=/models/qwen3.6-27b-autoround

# Quantization format. auto-round for AutoRound INT4 safetensors.
SGLANG_QUANTIZATION=auto-round

# HuggingFace repo ID or local path for the tokenizer.
# Leave empty — the tokenizer is bundled in the AutoRound repo.
SGLANG_TOKENIZER_PATH=

# Model alias returned by /v1/models and referenced in chat completion requests.
SGLANG_SERVED_MODEL_NAME=qwen3.6-27b

# =============================================================================
# Inference
# =============================================================================

# Maximum context window in tokens (per request cap — does NOT size the KV pool directly).
# 100k per slot with 2 slots requires turboquant_3bit_nc for compressed KV storage (~4.9x vs BF16).
# Reduce if OOM; raise toward 125k if startup logs show sufficient pool headroom.
SGLANG_CONTEXT_LENGTH=100000

# Fraction of GPU VRAM allocated to weights + KV cache (0.0–1.0).
# Lower if loading fails; raise to maximise usable context.
SGLANG_MEM_FRACTION_STATIC=0.83

# Maximum concurrent in-flight requests (parallel slots).
SGLANG_MAX_RUNNING_REQUESTS=2

# Tensor parallelism — number of GPUs to shard the model across.
SGLANG_TP_SIZE=1

# Weight precision: auto, float16, bfloat16.
# float16 required for TurboQuant KV kernels on RTX 3090 (SM86).
SGLANG_DTYPE=auto

# KV cache quantization format. turboquant_2bit gives maximum compression for
# long-context workloads. Options: turboquant_2bit, turboquant_3bit_nc, fp8_e5m2.
# Leave empty to use full-precision KV cache (bfloat16/float16 per SGLANG_DTYPE).
SGLANG_KV_CACHE_DTYPE=turboquant_2bit

# Chunked prefill token budget per batch step.
# 8192 significantly improves prefill throughput on RTX 3090 vs the default 2048.
SGLANG_CHUNKED_PREFILL_SIZE=8192

# Hard ceiling on total tokens across all in-flight requests (weights + KV pool).
# Leave empty — SGLang auto-sizes from mem_fraction_static. Set explicitly to
# prevent OOM when context_length × max_running_requests exceeds available VRAM
# (e.g., SGLANG_MAX_TOTAL_TOKENS=65536 on a 24 GB GPU at 0.95 mem fraction).
SGLANG_MAX_TOTAL_TOKENS=

# Maximum requests that may queue waiting for a slot. Leave empty for unlimited.
SGLANG_MAX_QUEUED_REQUESTS=

# Continuous decode steps between scheduler passes. Higher = less scheduler overhead.
# 5 is a good balance for speculative decoding on a single low-concurrency server.
SGLANG_NUM_CONTINUOUS_DECODE_STEPS=5

# Mix prefill and decode in the same forward pass for better GPU utilisation.
# Set to 1 to enable, leave empty to disable.
SGLANG_ENABLE_MIXED_CHUNK=1

# Reduce CUDA allocator fragmentation, especially under long-context workloads.
# max_split_size_mb:512 limits block splitting to reduce fragmentation under KV cache pressure.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:512

# =============================================================================
# Scheduler
# =============================================================================

# Request scheduling policy.
# fcfs              — first-come-first-served (default, lowest latency variance).
# lpm               — longest-prefix-match (maximises radix cache reuse).
# shortest_job_first — prefer shorter requests (reduces head-of-line blocking).
SGLANG_SCHEDULE_POLICY=fcfs

# =============================================================================
# Sampling
# =============================================================================

# Server-level sampling defaults when a client omits a parameter.
# model  — use the model's own config (Qwen3.6 ships temp=0.6, top_p=0.95, top_k=20).
# openai — OpenAI-compatible defaults (temp=1.0, top_p=1.0, top_k=-1).
SGLANG_SAMPLING_DEFAULTS=model

# =============================================================================
# Reasoning Models
# =============================================================================

# Parser for structured <think>…</think> output extraction.
# Options: qwen3, deepseek. Leave empty to disable reasoning extraction.
SGLANG_REASONING_PARSER=qwen3

# =============================================================================
# Speculative Decoding
# =============================================================================

# Speculative algorithm. SGLang supports ONE algorithm at a time.
#
#   NEXTN   — uses the model's own MTP heads for single-path draft decoding.
#             No separate draft model required. AutoRound models preserve MTP
#             heads in BF16 → ~90% draft acceptance on RTX 3090.
#
#   NGRAM   — predicts from n-gram cache. Works with any model. CUDA-only.
#             Fallback if NEXTN acceptance rate is low.
#
#   EAGLE   — EAGLE-2/3 tree-based draft. Requires a separate EAGLE draft model.
#
SGLANG_SPECULATIVE_ALGO=NGRAM

# Speculative steps per decode iteration.
SGLANG_SPECULATIVE_NUM_STEPS=3

# Top-k for draft tree branching. 1 = single-path (linear) — recommended for NEXTN.
SGLANG_SPECULATIVE_EAGLE_TOPK=1

# Maximum draft tokens proposed per step.
# 3 yields 3.4–3.8 average acceptance length on Qwen3.6-27B INT4 (sweet spot).
SGLANG_SPECULATIVE_NUM_DRAFT_TOKENS=3

# Mamba/DeltaNet scheduler strategy for hybrid recurrent models (Qwen3.6, Jamba).
# extra_buffer — required when speculative decoding + radix cache are both active.
#               entrypoint.sh automatically sets SGLANG_ENABLE_SPEC_V2=1 alongside.
# no_buffer   — lighter path; use when speculative decoding is disabled.
SGLANG_MAMBA_SCHEDULER_STRATEGY=extra_buffer

# Precision for the Mamba SSM recurrent state cache.
SGLANG_MAMBA_SSM_DTYPE=bfloat16

# Fraction of the Mamba state pool reserved for full-state (non-speculative) slots.
SGLANG_MAMBA_FULL_MEMORY_RATIO=0.8

# Hard cap on the total Mamba recurrent state pool size (number of slots).
# Leave empty to let SGLang auto-size from mem_fraction_static.
# Set an integer (e.g. 4) to prevent the pool from growing beyond a fixed slot count.
SGLANG_MAX_MAMBA_CACHE_SIZE=

# =============================================================================
# Model Download
# =============================================================================

# Required for gated / private HuggingFace models.
HF_TOKEN=

# =============================================================================
# Cloudflare Tunnel
# =============================================================================

# Token from Zero Trust → Networks → Tunnels → Create tunnel → Docker.
CF_TUNNEL_TOKEN=

# =============================================================================
# MCP Search Server
# =============================================================================

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=3100

SEARCH_ENGINE=duckduckgo
SEARCH_API_KEY=
BROWSER_TIMEOUT=30
MAX_RESULTS=10
CACHE_ENABLED=true
CACHE_TTL=3600

# Auto-generated by sync-env.py if empty. Regenerate: python sync-env.py --regenerate
MCP_API_KEY=

# Base URL used to build download links for files served by the MCP server.
FILE_BASE_URL=https://mcp.jessfan.com

# CORS for the SGLang HTTP server. SGLang has no native --cors flag; origins are
# enforced upstream by Cloudflare Access. This variable is read by docker-compose
# for reference only — it is NOT forwarded to sglang.launch_server.
SGLANG_CORS_ORIGINS=*

# Allowed CORS origins for the MCP server. Default "*" for local dev.
# In production set to your UI domain: https://chat.jessfan.com
MCP_CORS_ORIGINS=*

# =============================================================================
# Chat UI (ui/ — Vite dev server)
# =============================================================================

# Port the Vite dev server binds on the host.
CHAT_UI_PORT=5173

# Firebase project credentials (same project as portfolio).
# Copy from Firebase Console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated Firebase UIDs allowed to use the chat UI.
# Find your UID in Firebase Console → Authentication → Users.
VITE_ADMIN_UID=

# =============================================================================
# Logging & Observability
# =============================================================================

# Logging verbosity for all SGLang loggers: debug, info, warning, error.
SGLANG_LOG_LEVEL=info

# Set to 1 to log metadata/inputs/outputs for every request (stdout).
SGLANG_LOG_REQUESTS=

# Set to 1 to expose Prometheus metrics at GET /metrics.
SGLANG_ENABLE_METRICS=
