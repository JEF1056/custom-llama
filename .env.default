# llama.cpp Server Configuration
# Copy this file to .env and modify as needed.
# Run: cp .env.default .env
#
# Model configuration (ctx, KV cache, sampling, speculative decoding, etc.)
# lives in scripts/models.ini → /etc/llama-server/models.ini inside the container.
# Edit that file to tune per-model or global parameters.

# =============================================================================
# Server
# =============================================================================

LLAMA_HOST=0.0.0.0
LLAMA_PORT=8080

# Optional API key — all requests must include Authorization: Bearer <key>.
LLAMA_API_KEY=

# =============================================================================
# Router Mode
# =============================================================================

# Path to the models preset INI inside the container (copied from scripts/models.ini).
LLAMA_MODELS_PRESET=/etc/llama-server/models.ini

# Maximum number of models loaded simultaneously (LRU eviction when exceeded).
# 1 = only one model hot at a time (recommended for RTX 3090 24GB).
LLAMA_MODELS_MAX=1

# Automatically load model instances on first request (vs. manual /models/load).
LLAMA_MODELS_AUTOLOAD=on

# =============================================================================
# CUDA Tuning (env vars, not CLI flags — apply to all modes)
# =============================================================================

# CUDA graph optimization. Disable to reclaim 3–6 GB VRAM on a budget 24GB card
# if VRAM headroom is tight. Re-enable only with ≥6 GB confirmed headroom.
GGML_CUDA_GRAPH_OPT=1

# CUDA launch queue scaling. 2x is sufficient for RTX 3090 single-GPU workloads.
CUDA_SCALE_LAUNCH_QUEUES=2x

# =============================================================================
# Model Download / Conversion
# =============================================================================

# Required for gated / private HuggingFace models.
HF_TOKEN=

# Throttle downloads via curl --limit-rate (e.g. 300M). Empty = full speed.
CONVERT_DOWNLOAD_RATE=

# CPU threads for llama-quantize. Default: cpu_count // 2.
CONVERT_THREADS=

# =============================================================================
# WebUI
# =============================================================================

LLAMA_WEBUI_CONFIG_FILE=/etc/llama-server/webui-config.json

# =============================================================================
# Cloudflare Tunnel
# =============================================================================

# Token from Zero Trust → Networks → Tunnels → Create tunnel → Docker.
CF_TUNNEL_TOKEN=

# =============================================================================
# MCP Search Server
# =============================================================================

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=3100

SEARCH_ENGINE=duckduckgo
SEARCH_API_KEY=
BROWSER_TIMEOUT=30
MAX_RESULTS=10
CACHE_ENABLED=true
CACHE_TTL=3600

# Auto-generated by sync-env.py if empty. Regenerate: python sync-env.py --regenerate
MCP_API_KEY=
