# llama.cpp Server Configuration
# Copy this file to .env and modify as needed.
# Run: cp .env.default .env
#
# Tuned for:  Intel i7-12700 | 32GB DDR4 | RTX 3090 24GB | Desktop (shared)

# =============================================================================
# Model Selection
# =============================================================================

# Automatic download + quantization on first start.
# QUANT accepts any standard quant (Q4_K_M, Q8_0, Q6_K, ...) or TurboQuant (TQ2_0, TQ1_0).
# If the requested quant is not pre-built on HuggingFace, the best available source
# (fp16 → bf16 → Q8_0 → ...) is downloaded, quantized locally, then deleted.
# On subsequent restarts the cached file is reused — no re-download.
MODEL_NAME=qwopus3.6-35b
QUANT=Q3_K_M

# Manual model override — set this to skip MODEL_NAME auto-download and point
# directly at a .gguf file already present in the ./models volume mount.
LLAMA_MODEL=

# =============================================================================
# Multimodal (Vision)
# =============================================================================

# Path to the mmproj file inside the container.
# When MODEL_NAME is set, manage_models.py auto-downloads the mmproj alongside
# the main model and places it at /models/<filename>.
LLAMA_MMPROJ=/models/mmproj.gguf

# Static image to pre-load for multimodal input (optional).
LLAMA_IMAGE=

# =============================================================================
# Server
# =============================================================================

LLAMA_HOST=0.0.0.0
LLAMA_PORT=8080

# =============================================================================
# CPU Threads
# =============================================================================
#
# i7-12700 layout: 8 P-cores (16 threads w/ HT) + 4 E-cores = 20 total threads.
#
# With full GPU offload (-ngl 99), the CPU only handles the embedding and
# final output layers — a tiny fraction of work. Decode thread count has
# almost no effect on tokens/second when all layers are on GPU.
#
# --threads      (-t):  threads for single-token decode (tiny GPU remainder).
#                       6 keeps most threads free for the desktop.
# --threads-batch(-tb): threads for GGML compute-graph scheduling during prefill.
#                       With full GPU offload these threads dispatch GPU kernels —
#                       they do NOT do the matrix math. 4 is enough to keep the
#                       GPU fed; 12 caused a 100% CPU spike on all P-cores with
#                       no throughput benefit since the GPU was the real bottleneck.

LLAMA_THREADS=6
LLAMA_THREADS_BATCH=4

# =============================================================================
# GPU / Context
# =============================================================================

# Offload all layers to RTX 3090. Use a high number — llama.cpp clamps to
# the model's actual layer count automatically.
LLAMA_GPU_LAYERS=99

# Context window in tokens — total pool shared across all parallel slots.
# With --parallel 2, each slot gets ctx_size / 2 = 100,000 tokens of context.
#
# Qwopus3.6-35B-A3B uses a hybrid architecture: roughly half its layers are
# Gated DeltaNet linear attention (no KV cache) and half are standard attention.
# This makes its KV cache roughly half that of a pure-transformer model.
#
# Rough VRAM estimate at 200K ctx, 2 slots, turbo3 KV:
#   Q3_K_M model:       ~15 GB
#   KV cache (3-bit,
#   ~32 attn layers,
#   200K total tokens): ~3–6 GB (depends on GQA config)
#   ─────────────────────────────
#   Total:              ~18–21 GB of 24 GB  ← should fit; watch for OOM
#
# Qwopus3.6-35B-A3B is a hybrid MoE: roughly half its layers are Gated
# DeltaNet linear attention (no KV cache) and half are standard attention,
# so the effective KV cache is roughly half that of a pure-transformer model.
# If you get OOM at startup, reduce to LLAMA_CTX_SIZE=131072 (64K/slot)
# or drop LLAMA_PARALLEL to 1 before reducing context further.
LLAMA_CTX_SIZE=200000

# =============================================================================
# Batch Processing
# =============================================================================
#
# --batch-size  (-b):  logical batch — tokens processed per prefill step.
#                      This is the primary lever for prompt ingestion speed.
#                      At 200K context a 50K prompt takes:
#                        2048 batch → ~24 GPU passes
#                        4096 batch → ~12 GPU passes  (2× faster prefill)
#                      RTX 3090 has ~15 GB free after the TQ2_0 model —
#                      4096 batch fits easily with headroom to spare.
# --ubatch-size (-ub): physical micro-batch sent to each CUDA kernel call.
#                      This is the primary lever for prefill speed. Each ubatch
#                      is one full GPU round-trip: a 4096-token prompt with
#                      ubatch=1024 requires 4 sequential GPU passes; with
#                      ubatch=2048 it needs only 2, roughly doubling prefill
#                      throughput. The 3090 has ~15 GB free after the TQ2_0
#                      model — 2048 fits easily. Reduce to 1024 only if you
#                      see OOM errors during long prompt processing.

LLAMA_BATCH_SIZE=4096
LLAMA_UBATCH_SIZE=2048

# =============================================================================
# KV Cache
# =============================================================================

# Cache quantization for K and V heads.
# Options: f16 (full precision), q8_0, q4_0, turbo3 (3-bit), turbo4 (4-bit).
# turbo3 requires Flash Attention. With Q3_K_M leaving ~9 GB free VRAM,
# turbo3 KV cache at 65536 ctx uses ~1–3 GB — well within budget.
# Fall back to q8_0 if you see KV cache quality issues (rare).
LLAMA_CACHE_TYPE_K=turbo3
LLAMA_CACHE_TYPE_V=turbo3

# Flash Attention: required for TurboQuant KV cache. Also reduces KV cache
# memory by 20-50% at long contexts — always worth enabling on RTX 30xx.
LLAMA_FLASH_ATTN=on

# KV cache offload control.
# off = allow llama.cpp to offload KV to CPU if VRAM is full (default/safe).
# on  = pass --no-kv-offload: force KV cache to stay on GPU at all times.
# With 24 GB VRAM and a ~9 GB TQ2_0 model there is ample headroom; keep off
# so the server can fall back to CPU rather than OOM if context spikes.
LLAMA_NO_KV_OFFLOAD=off

# =============================================================================
# Parallel Slots
# =============================================================================

# Concurrent inference slots. Slots share model weights; only KV cache is
# duplicated per slot. 2 is a good default for a shared desktop.
# The total KV cache pool = CTX_SIZE × PARALLEL, so 200000 × 2 = 400K tokens.
LLAMA_PARALLEL=2

# =============================================================================
# Memory Mapping
# =============================================================================

# off = use mmap (OS loads model pages on demand — efficient on SSD, low RAM).
# on  = load full model into RAM upfront (consistent latency, needs ~9 GB RAM).
# With 32 GB system RAM and a desktop with other apps running, keep mmap on (off).
LLAMA_NO_MMAP=off

# Direct I/O: bypass the OS page cache when reading the model file during load.
# on  = O_DIRECT — model data skips the page cache entirely. Recommended when
#       all layers are GPU-offloaded (ngl 99): the ~9 GB model only needs to be
#       read once into VRAM; caching it in RAM wastes page-cache budget that
#       other desktop apps could use.
# off = normal cached I/O (default). Better if ngl < 99 or if you restart the
#       server frequently and want the second cold-start to hit the page cache.
LLAMA_DIRECT_IO=on

# =============================================================================
# Generation
# =============================================================================

# Maximum tokens to generate per response.
# -1 = unlimited — the model generates until EOS or the slot context is full
#      (100K tokens with the 200K/2-slot config above).
# This is the right default for a reasoning model with a large context window.
# Clients can always cap responses shorter via max_tokens in their API request.
# Set to a positive integer only if you need a hard server-side cap.
LLAMA_MAX_TOKENS=-1
LLAMA_TOP_P=0.95
LLAMA_TEMP=0.7

# Stop sequences — tokens/strings that terminate generation (space-separated or JSON list).
# Leave empty to rely on the model's native EOS token only.
LLAMA_STOP=

# Reasoning / chain-of-thought output.
# Enable for models trained with reasoning (Qwen, DeepSeek-R1, QwQ, etc.).
LLAMA_REASONING=on

# preserve_thinking: keep prior <think>…</think> blocks in the prompt across turns.
# Qwopus3.6 / Qwen3.6 chat templates support this kwarg natively.
# When on, historical assistant reasoning is included in the context on every
# subsequent turn, which:
#   - prevents the model from "forgetting" its prior chain-of-thought
#   - maximises KV-cache prefix reuse (no recomputation on follow-up turns)
#   - is especially valuable for multi-turn reasoning / agent / tool-call flows
# Requires LLAMA_REASONING=on. Has no effect on models whose templates don't
# define the preserve_thinking variable (it is silently ignored by Jinja).
LLAMA_PRESERVE_THINKING=on

# =============================================================================
# Multi-GPU / MoE
# =============================================================================

# Tensor split across GPUs (e.g., "13,14" for two GPUs). Leave empty for single GPU.
LLAMA_TS=

# Number of MoE experts to offload to CPU.
# qwopus uses 256 experts but only 3B active params — full GPU fit is fine.
LLAMA_NCMOE=

# =============================================================================
# Model Conversion / Quantization  (Windows BSOD prevention)
# =============================================================================
#
# CLOCK_WATCHDOG_TIMEOUT BSODs on Windows (Docker Desktop / WSL2) can happen at
# two stages of model preparation:
#
#   1. During DOWNLOAD  — large file writes (14-18 GB) saturate the WSL2 virtual
#      disk interface, causing vmmem to balloon and starving Windows of RAM and
#      CPU interrupt time.  Fix: throttle write speed with CONVERT_DOWNLOAD_RATE.
#
#   2. During QUANTIZATION — llama-quantize pegs every logical CPU at 100%,
#      starving the Windows kernel watchdog timer.
#      Fix: cap thread count with CONVERT_THREADS.
#
# ── Download throttle ────────────────────────────────────────────────────────
#
# CONVERT_DOWNLOAD_RATE: when set, all single-file downloads are routed through
# curl --limit-rate instead of huggingface_hub.  Use curl rate syntax:
#   500M = 500 MB/s,  200M = 200 MB/s,  100M = 100 MB/s
#
# Start with 300M and lower further if BSODs still occur on download.
# Leave empty to download at full speed (fine if you have no BSOD issues).
CONVERT_DOWNLOAD_RATE=
# CONVERT_DOWNLOAD_RATE=300M

# ── Quantization thread cap ───────────────────────────────────────────────────
#
# CONVERT_THREADS: CPU threads for llama-quantize.
# Default (unset): cpu_count // 2  — half the logical cores; on a 20-thread
# i7-12700 that means 10 threads, which is still fast while leaving the other
# 10 for Windows.  Lower further if BSODs happen during quantization.
CONVERT_THREADS=
# CONVERT_THREADS=4

# ── System-level fix (recommended in addition to the above) ──────────────────
#
# WSL2's vmmem process can claim most of Windows RAM for its page cache during
# large downloads even with rate limiting.  Cap WSL2 memory globally by creating
# (or editing) %USERPROFILE%\.wslconfig on the Windows host:
#
#   [wsl2]
#   memory=12GB        # hard cap for WSL2 / Docker Desktop VM
#   swap=4GB
#   processors=10      # optional: also limit logical CPUs
#
# After editing, restart WSL2:  wsl --shutdown  (then reopen Docker Desktop)

# =============================================================================
# HuggingFace
# =============================================================================

# Required for gated / private models.
HF_TOKEN=

# =============================================================================
# Tailscale
# =============================================================================

# Auth key from Tailscale admin (Settings → Keys → Generate auth key).
# Use an ephemeral, pre-authorized key tagged with the machine tag you define
# in your ACL policy (e.g. tag:llama).
TS_AUTHKEY=

# Hostname the llama-server sidecar advertises on the tailnet.
TS_HOSTNAME=llama-api

# Additional tailscaled flags, e.g. --advertise-tags=tag:llama
TS_EXTRA_ARGS=

# =============================================================================
# Cloudflare Tunnel
# =============================================================================

# Token from Cloudflare Zero Trust → Networks → Tunnels → Create tunnel → Docker.
# The tunnel should have a Public Hostname route: chat.jessfan.com → http://open-webui:3000
CF_TUNNEL_TOKEN=

# =============================================================================
# Open WebUI
# =============================================================================

# Random secret used to sign Open WebUI session tokens.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Public URL of the Open WebUI instance (used for OAuth redirect URIs).
WEBUI_URL=https://chat.jessfan.com

# Google OAuth credentials from Firebase Console (or Google Cloud Console).
# Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OIDC discovery endpoint — always accounts.google.com regardless of whether
# the credentials were created in Firebase or Google Cloud Console directly.
OPENID_PROVIDER_URL=https://accounts.google.com/.well-known/openid-configuration

# Allow new users to register via OAuth (set to false to lock to existing accounts).
ENABLE_OAUTH_SIGNUP=true

# =============================================================================
# KV Cache / Slot Persistence
# =============================================================================

# Directory inside the container where llama.cpp writes slot state files.
# Maps to ./models/slots on the host (already on the ./models volume).
# Used by POST /slots/{id}?action=save and ?action=restore so that
# per-conversation KV caches survive server restarts.
# Requires llama.cpp >= b3000 (upstream) or equivalent TurboQuant build.
LLAMA_SLOT_SAVE_PATH=/models/slots

# =============================================================================
# KV Cache Proxy (Roo Code / tailnet access)
# =============================================================================

# Port the kv-cache-proxy listens on inside the tailnet.
KV_PROXY_PORT=8181

# =============================================================================
# OpenClaw Gateway (CLI companion on tailnet)
# =============================================================================

# Bearer token required by CLI clients to authenticate with the Gateway.
# Generate with: openssl rand -hex 32
# CLI usage: openclaw --gateway http://<TS_HOSTNAME>.<tailnet>.ts.net:18789 \
#                     --token <value> agent --message "..."
OPENCLAW_GATEWAY_TOKEN=

# =============================================================================
# Open WebUI Pipelines
# =============================================================================

# Shared secret between Open WebUI and the pipelines server.
# Generate with: openssl rand -hex 16
# Must match OPENAI_API_KEY in the open-webui service.
PIPELINES_API_KEY=
