# SGLang Server Configuration
# Copy this file to .env and modify as needed.
# Run: python sync-env.py

# =============================================================================
# SGLang Server
# =============================================================================

SGLANG_HOST=0.0.0.0
SGLANG_PORT=8080

# Optional API key — all requests must include Authorization: Bearer <key>.
SGLANG_API_KEY=

# =============================================================================
# Model (GGUF)
# =============================================================================

# Absolute path to GGUF file inside the container.
# Prepare with: docker compose run --rm llama-convert convert-st qwen3.6-27b --quant IQ4_XS --mtp
# Use the -mtp suffix when SGLANG_SPECULATIVE_ALGO=NEXTN (MTP heads required).
# Without MTP: docker compose run --rm llama-convert download qwen3.6-27b --quant IQ4_XS
SGLANG_MODEL_PATH=/models/qwen3.6-27b-IQ4_XS-mtp.gguf

# HuggingFace repo ID or local path for the tokenizer.
# Required when serving GGUF — the GGUF format doesn't embed an HF-compatible tokenizer.
SGLANG_TOKENIZER_PATH=Qwen/Qwen3.6-27B

# Model alias returned by /v1/models and referenced in chat completion requests.
SGLANG_SERVED_MODEL_NAME=qwen3.6-27b

# =============================================================================
# Inference
# =============================================================================

# Maximum context window in tokens. Reduce if OOM during model load.
SGLANG_CONTEXT_LENGTH=262144

# Fraction of GPU VRAM allocated to weights + KV cache (0.0–1.0).
# Lower if loading fails; raise to maximise usable context.
SGLANG_MEM_FRACTION_STATIC=0.90

# Maximum concurrent in-flight requests (parallel slots).
SGLANG_MAX_RUNNING_REQUESTS=3

# Tensor parallelism — number of GPUs to shard the model across.
SGLANG_TP_SIZE=1

# Weight precision: auto, float16, bfloat16.
SGLANG_DTYPE=auto

# KV cache quantization dtype: auto, fp8_e5m2, fp8_e4m3.
SGLANG_KV_CACHE_DTYPE=turboquant_k4v2

# Chunked prefill token budget per batch step. Leave empty for SGLang auto-tuning.
SGLANG_CHUNKED_PREFILL_SIZE=

# =============================================================================
# Reasoning Models
# =============================================================================

# Parser for structured <think>…</think> output extraction.
# Options: qwen3, deepseek. Leave empty to disable reasoning extraction.
SGLANG_REASONING_PARSER=qwen3

# =============================================================================
# Speculative Decoding
# =============================================================================

# Speculative algorithm. SGLang supports ONE algorithm at a time — no fallback chain.
#
#   NEXTN   — uses the model's own MTP (multi-token prediction) heads for single-path
#             draft decoding. No separate draft model required. Recommended by Unsloth
#             for Qwen3.6 GGUFs. Set SGLANG_SPECULATIVE_EAGLE_TOPK=1 for linear draft.
#             ✅ Recommended default for MTP-capable models.
#
#   NGRAM   — no draft model required; predicts from n-gram cache of recent tokens.
#             Works with any GGUF. CUDA-only. Fallback for non-MTP models.
#
#   EAGLE   — EAGLE-2/3 tree-based draft. Requires a separate EAGLE draft model.
#
SGLANG_SPECULATIVE_ALGO=NEXTN

# Speculative steps per decode iteration.
SGLANG_SPECULATIVE_NUM_STEPS=3

# Top-k for draft tree branching. 1 = single-path (linear) draft — recommended
# for NEXTN with MTP heads (matches Unsloth's Qwen3.6 guidance).
SGLANG_SPECULATIVE_EAGLE_TOPK=1

# Maximum draft tokens proposed per step.
SGLANG_SPECULATIVE_NUM_DRAFT_TOKENS=4

# =============================================================================
# Model Download / Conversion
# =============================================================================

# Required for gated / private HuggingFace models.
HF_TOKEN=

# Throttle downloads via curl --limit-rate (e.g. 300M). Empty = full speed.
CONVERT_DOWNLOAD_RATE=400M

# CPU threads for llama-quantize. Default: cpu_count // 2.
CONVERT_THREADS=

# =============================================================================
# Cloudflare Tunnel
# =============================================================================

# Token from Zero Trust → Networks → Tunnels → Create tunnel → Docker.
CF_TUNNEL_TOKEN=

# =============================================================================
# MCP Search Server
# =============================================================================

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=3100

SEARCH_ENGINE=duckduckgo
SEARCH_API_KEY=
BROWSER_TIMEOUT=30
MAX_RESULTS=10
CACHE_ENABLED=true
CACHE_TTL=3600

# Auto-generated by sync-env.py if empty. Regenerate: python sync-env.py --regenerate
MCP_API_KEY=

# Base URL used to build download links for files served by the MCP server.
FILE_BASE_URL=https://mcp.jessfan.com

# Allowed CORS origins for SGLang. Default "*" for local dev.
# In production set to your UI domain: https://chat.jessfan.com
SGLANG_CORS_ORIGINS=*

# Allowed CORS origins for the MCP server. Default "*" for local dev.
# In production set to your UI domain: https://chat.jessfan.com
MCP_CORS_ORIGINS=*

# =============================================================================
# Chat UI (ui/ — Vite dev server)
# =============================================================================

# Port the Vite dev server binds on the host.
CHAT_UI_PORT=5173

# Firebase project credentials (same project as portfolio).
# Copy from Firebase Console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated Firebase UIDs allowed to use the chat UI.
# Find your UID in Firebase Console → Authentication → Users.
VITE_ADMIN_UID=
