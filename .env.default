# llama.cpp Server Configuration
# Copy this file to .env and modify as needed.
# Run: cp .env.default .env
#
# Tuned for:  Intel i7-12700 | 32GB DDR4 | RTX 3090 24GB | Desktop (shared)

# =============================================================================
# Model Selection
# =============================================================================

# Automatic download + quantization on first start.
# QUANT accepts any standard quant (Q4_K_M, Q8_0, Q6_K, ...) or TurboQuant (TQ2_0, TQ1_0).
# If the requested quant is not pre-built on HuggingFace, the best available source
# (fp16 → bf16 → Q8_0 → ...) is downloaded, quantized locally, then deleted.
# On subsequent restarts the cached file is reused — no re-download.
MODEL_NAME=qwopus3.6-35b
QUANT=TQ2_0

# Manual model override — set this to skip MODEL_NAME auto-download and point
# directly at a .gguf file already present in the ./models volume mount.
LLAMA_MODEL=

# =============================================================================
# Multimodal (Vision)
# =============================================================================

# Path to the mmproj file inside the container.
# When MODEL_NAME is set, manage_models.py auto-downloads the mmproj alongside
# the main model and places it at /models/<filename>.
LLAMA_MMPROJ=/models/mmproj.gguf

# Static image to pre-load for multimodal input (optional).
LLAMA_IMAGE=

# =============================================================================
# Server
# =============================================================================

LLAMA_HOST=0.0.0.0
LLAMA_PORT=8080

# =============================================================================
# CPU Threads
# =============================================================================
#
# i7-12700 layout: 8 P-cores (16 threads w/ HT) + 4 E-cores = 20 total threads.
#
# With full GPU offload (-ngl 99), the CPU only handles the embedding and
# final output layers — a tiny fraction of work. Decode thread count has
# almost no effect on tokens/second when all layers are on GPU.
#
# --threads      (-t):  threads for single-token decode (tiny GPU remainder).
#                       6 keeps most threads free for the desktop.
# --threads-batch(-tb): threads for prompt prefill/ingestion (bursty, brief).
#                       12 uses most P-cores for fast prompt processing while
#                       leaving E-cores + a couple P-cores for the desktop.

LLAMA_THREADS=6
LLAMA_THREADS_BATCH=12

# =============================================================================
# GPU / Context
# =============================================================================

# Offload all layers to RTX 3090. Use a high number — llama.cpp clamps to
# the model's actual layer count automatically.
LLAMA_GPU_LAYERS=99

# Context window in tokens — total pool shared across all parallel slots.
# With --parallel 2, each slot gets ctx_size / 2 = 100,000 tokens of context.
#
# Qwopus3.6-35B-A3B uses a hybrid architecture: roughly half its layers are
# Gated DeltaNet linear attention (no KV cache) and half are standard attention.
# This makes its KV cache roughly half that of a pure-transformer model.
#
# Rough VRAM estimate at 200K ctx, 2 slots, turbo3 KV:
#   TQ2_0 model:        ~9.0 GB
#   KV cache (3-bit,
#   ~32 attn layers,
#   200K total tokens): ~5–10 GB (depends on GQA config)
#   ─────────────────────────────
#   Total:              ~14–19 GB of 24 GB  ← should fit
#
# If you get OOM at startup, reduce to LLAMA_CTX_SIZE=131072 (64K/slot)
# or drop LLAMA_PARALLEL to 1 before reducing context.
LLAMA_CTX_SIZE=200000

# Prompt cache capacity in tokens — how much of the KV cache is preserved
# across requests to avoid recomputing repeated system prompts.
# Match CTX_SIZE so the full context pool is eligible for caching.
LLAMA_CACHE_CAPACITY=200000

# =============================================================================
# Batch Processing
# =============================================================================
#
# --batch-size  (-b):  logical batch — tokens processed per prefill step.
#                      This is the primary lever for prompt ingestion speed.
#                      At 200K context a 50K prompt takes:
#                        2048 batch → ~24 GPU passes
#                        4096 batch → ~12 GPU passes  (2× faster prefill)
#                      RTX 3090 has ~15 GB free after the TQ2_0 model —
#                      4096 batch fits easily with headroom to spare.
# --ubatch-size (-ub): physical micro-batch sent to each CUDA kernel call.
#                      Increasing from 512 → 1024 better utilises the 3090's
#                      compute width and reduces kernel launch overhead during
#                      long prefill passes. Reduce back to 512 if you hit OOM
#                      during prompt processing.

LLAMA_BATCH_SIZE=4096
LLAMA_UBATCH_SIZE=1024

# =============================================================================
# KV Cache
# =============================================================================

# Cache quantization for K and V heads.
# Options: f16 (full precision), turbo3 (3-bit), turbo4 (4-bit).
# turbo3 requires Flash Attention and a TurboQuant-capable model.
# With 15 GB free VRAM and turbo3, 16K context uses under 1 GB.
LLAMA_CACHE_TYPE_K=turbo3
LLAMA_CACHE_TYPE_V=turbo3

# Flash Attention: required for TurboQuant KV cache. Also reduces KV cache
# memory by 20-50% at long contexts — always worth enabling on RTX 30xx.
LLAMA_FLASH_ATTN=on

# Multi-KV attention: reduces KV cache for multimodal models.
LLAMA_MUL_KV=on

# KV cache chunk size for multimodal image tokens (0 = default).
LLAMA_CACHE_CHUNK_SIZE=0

# KV cache offload control.
# off = allow llama.cpp to offload KV to CPU if VRAM is full (default/safe).
# on  = pass --no-kv-offload: force KV cache to stay on GPU at all times.
# With 24 GB VRAM and a ~9 GB TQ2_0 model there is ample headroom; keep off
# so the server can fall back to CPU rather than OOM if context spikes.
LLAMA_NO_KV_OFFLOAD=off

# =============================================================================
# Parallel Slots
# =============================================================================

# Concurrent inference slots. Slots share model weights; only KV cache is
# duplicated per slot. 2 is a good default for a shared desktop.
# The total KV cache pool = CTX_SIZE × PARALLEL, so 200000 × 2 = 400K tokens.
LLAMA_PARALLEL=2

# =============================================================================
# Memory Mapping
# =============================================================================

# off = use mmap (OS loads model pages on demand — efficient on SSD, low RAM).
# on  = load full model into RAM upfront (consistent latency, needs ~9 GB RAM).
# With 32 GB system RAM and a desktop with other apps running, keep mmap on (off).
LLAMA_NO_MMAP=off

# =============================================================================
# Generation
# =============================================================================

# Maximum tokens to generate per response.
# -1 = unlimited — the model generates until EOS or the slot context is full
#      (100K tokens with the 200K/2-slot config above).
# This is the right default for a reasoning model with a large context window.
# Clients can always cap responses shorter via max_tokens in their API request.
# Set to a positive integer only if you need a hard server-side cap.
LLAMA_MAX_TOKENS=-1
LLAMA_TOP_P=0.95
LLAMA_TEMP=0.7

# Stop sequences — tokens/strings that terminate generation (space-separated or JSON list).
# Leave empty to rely on the model's native EOS token only.
LLAMA_STOP=

# Reasoning / chain-of-thought output.
# Enable for models trained with reasoning (Qwen, DeepSeek-R1, QwQ, etc.).
LLAMA_REASONING=on

# preserve_thinking: keep prior <think>…</think> blocks in the prompt across turns.
# Qwopus3.6 / Qwen3.6 chat templates support this kwarg natively.
# When on, historical assistant reasoning is included in the context on every
# subsequent turn, which:
#   - prevents the model from "forgetting" its prior chain-of-thought
#   - maximises KV-cache prefix reuse (no recomputation on follow-up turns)
#   - is especially valuable for multi-turn reasoning / agent / tool-call flows
# Requires LLAMA_REASONING=on. Has no effect on models whose templates don't
# define the preserve_thinking variable (it is silently ignored by Jinja).
LLAMA_PRESERVE_THINKING=on

# =============================================================================
# Multi-GPU / MoE
# =============================================================================

# Tensor split across GPUs (e.g., "13,14" for two GPUs). Leave empty for single GPU.
LLAMA_TS=

# Number of MoE experts to offload to CPU.
# qwopus uses 256 experts but only 3B active params — full GPU fit is fine.
LLAMA_NCMOE=

# =============================================================================
# HuggingFace
# =============================================================================

# Required for gated / private models.
HF_TOKEN=
