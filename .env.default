# vLLM Server Configuration — Optimized for single RTX 3090 (24 GB)
# Copy this file to .env and modify as needed.
# Run: python sync-env.py

# =============================================================================
# vLLM Server
# =============================================================================

LLM_HOST=0.0.0.0
LLM_PORT=8080

# All requests must include Authorization: Bearer <key>.
LLM_API_KEY=

# =============================================================================
# Model — Qwen3.6-27B AutoRound INT4 (~19 GB VRAM)
# =============================================================================

# Local directory containing safetensors weights.
LLM_MODEL_PATH=/models/qwen3.6-27b-autoround

# Quantization format. AutoRound INT4 models are auto-detected from config;
# leave empty to let vLLM infer from the checkpoint's quantize_config.json.
LLM_QUANTIZATION=

# Override tokenizer path; leave empty to use the one bundled with the model.
LLM_TOKENIZER_PATH=

# Model alias returned by /v1/models and used in chat completion requests.
LLM_SERVED_MODEL_NAME=qwen3.6-27b

# =============================================================================
# Inference — RTX 3090 24 GB budget
#
# Qwen3.6-27B architecture (from config.json):
#   64 layers total — hybrid gated delta-net:
#     48× linear attention (recurrent state, fixed-size, no per-token KV)
#     16× full attention   (standard KV cache, GQA: 24 Q → 4 KV heads × 256 head_dim)
#   Vision: 27-layer ViT encoder (1152 hidden → 5120 projection)
#
# VRAM budget breakdown:
#   WSL2 container CUDA context:               ~1.3 GB
#     (locked on container start; invisible to nvidia-smi at idle)
#   Model weights (INT4 + scales/zeros):       ~15.5 GB
#     (27B × 0.5 B/param + ~15% group overhead; includes LM head if
#      quantized — check quantize_config.json for your checkpoint)
#   Embedding table (BF16, not quantized):      ~2.4 GB
#     (vocab 248320 × hidden 5120 × 2 bytes)
#   Vision tower (BF16):                       ~0.4 GB
#   MTP heads (BF16):                          ~0.2 GB
#   Linear attn recurrent state (fixed):       ~0.1 GB
#     (48 layers × 16 key_heads × 128 key_dim × 384 value_dim; BF16–FP32)
#   Activations + PyTorch overhead:            ~0.5 GB
#   ─────────────────────────────────────────────────────
#   Total non-KV:                              ~20.4 GB
#
# KV cache math (only 16 full-attention layers cache KV):
#   Per token (BF16): 2 × 16 layers × 4 heads × 256 dim × 2 B = 65,536 B = 64 KB
#   Usable VRAM:      24 GB × 0.94 = 22.56 GB
#   Actual usable:    22.56 - 1.3 (WSL2) = 21.26 GB
#     (gpu_memory_utilization is applied to total VRAM reported by the driver;
#      WSL2's CUDA context is already allocated before vLLM profiles)
#   KV budget (raw):  22.56 - 20.4 = 2.16 GB
#   Raw capacity:     2,160 MB / 0.0625 MB = ~34,560 tokens
#   With k4v2_nc (5.0×): 34,560 × 5.0 = ~173,000 tokens
#
# → 100K context × 2 seqs = 200K > 173K — will fit only if both requests
#   don't simultaneously hit max length. vLLM preempts/swaps under pressure.
#   At batch size 1, 100K fits comfortably (~73K headroom).
#   At batch size 2, safe per-slot max is ~86K tokens each.
# =============================================================================

# Maximum context window in tokens per request.
# Total KV capacity is ~173K tokens (2.16 GB raw × 5.0× k4v2_nc / 64 KB).
# 100K per slot fits at batch size 1 with 73K headroom. At batch size 2,
# vLLM swaps/preempts if both slots approach max simultaneously.
LLM_MAX_MODEL_LEN=100000

# Fraction of GPU VRAM allocated to model weights + KV cache (0.0–1.0).
# 0.94 → 22.56 GB cap. Non-KV overhead ~20.4 GB → ~2.16 GB raw for KV
# (→ ~173K tokens compressed with k4v2_nc).
# Lower to 0.92 if you see OOM from activation spikes on very long sequences.
LLM_GPU_MEMORY_UTILIZATION=0.94

# Maximum concurrent sequences in a batch.
# At 100K tokens × 64 KB/token / 5.0 = ~1.25 GB per sequence (compressed).
# Budget of 2.16 GB fits 1 full 100K sequence with headroom. 2 concurrent 100K
# sequences (2.50 GB) exceeds budget — vLLM will swap/preempt the second.
# Most real requests are shorter than max, so 2 slots works in practice.
# Set to 4–8 if you lower max_model_len to 32768.
LLM_MAX_NUM_SEQS=2

# Number of GPUs to shard the model across.
LLM_TP_SIZE=1

# Weight precision: auto lets vLLM use the checkpoint's native dtype.
# INT4 AutoRound stores compute in float16 internally.
LLM_DTYPE=auto

# KV cache quantization via TurboQuant (ICLR 2026, upstream since vLLM 0.20).
# Available presets:
#   turboquant_k8v4    — FP8 keys + 4-bit values, 2.6× compression, +1.17% PPL
#   turboquant_4bit_nc — 4-bit keys + 4-bit values + NC, 3.8×, +2.71% PPL
#   turboquant_k4v2_nc — 4-bit keys + 2-bit values + NC, 5.0×  (recommended)
#   turboquant_k3v4_nc — 3-bit keys + 4-bit values + NC, ~3.5×, +10.63% PPL
#   turboquant_3bit_nc — 3-bit keys + 3-bit values + NC, 5.0×, +20.59% PPL
#   fp8 / fp8_e5m2     — standard FP8, 2× compression, ~0% PPL impact
#   auto               — full precision (no compression)
#
# k4v2_nc allocates more bits to keys (which are ~37× more sensitive to
# quantization than values per KIVI/KV-AdaQuant research) and fewer to
# values (which tolerate aggressive compression via softmax averaging).
# Same 5.0× compression as 3bit_nc but better attention routing quality.
# Requires vllm-turboquant fork: JEF1056/vllm-turboquant@turboquant-k4v2-nc
LLM_KV_CACHE_DTYPE=turboquant_k4v2_nc

# Maximum tokens in a single prefill batch step.
# Controls prefill chunk size when chunked prefill is enabled.
# Larger values → lower TTFT (fewer chunks per prompt) but higher activation
# memory spikes. Smaller values → better ITL (less decode starvation) but
# higher TTFT for long prompts.
LLM_MAX_NUM_BATCHED_TOKENS=8192

# Chunked prefill interleaves prefill and decode for better GPU utilisation.
# Recommended for long-context workloads on memory-constrained GPUs.
# Trade-off: chunks long prefills into max_num_batched_tokens steps, adding
# TTFT latency for prompts > max_num_batched_tokens. Disable (empty) if
# single-request TTFT is the only priority.
LLM_ENABLE_CHUNKED_PREFILL=1

# Prefix caching reuses KV cache for repeated prompt prefixes.
# vLLM V1 implements prefix caching with zero overhead — it is the default
# and recommended for all workloads. Compatible with MTP speculative decoding.
LLM_ENABLE_PREFIX_CACHING=1

# Disable CUDA graph capture (saves ~1.5 GB VRAM, 10-30% slower decode).
# With only 16 full-attention layers (hybrid arch), CUDA graph overhead is lower
# than a pure transformer. Try empty first; set to 1 if OOM during graph capture.
# enforce_eager=1 would increase KV budget from 2.16 to ~3.66 GB (~293K tokens).
LLM_ENFORCE_EAGER=

# CUDA allocator config.
# expandable_segments MUST be False on WSL2 — the cuMemMap virtual-memory API
# used by expandable_segments:True crashes gptq_marlin_repack with
# "CUDA driver error: device not ready". This is a known PyTorch/WSL2 bug.
# max_split_size_mb reduces fragmentation under long-context workloads.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False,max_split_size_mb:512

# =============================================================================
# Scheduler
# =============================================================================

# Scheduling policy: fcfs (first-come-first-served) or priority.
LLM_SCHEDULING_POLICY=

# =============================================================================
# Performance Tuning — VRAM, Speed & TTFT
# =============================================================================

# Offload model weights to CPU RAM (GiB, default: 0).
# Frees GPU VRAM for more KV cache at the cost of CPU→GPU PCIe transfer
# latency on every forward pass. Effective only with fast PCIe (Gen4 x16).
# Example: 2 → frees ~2 GB GPU VRAM → ~160K extra compressed KV tokens.
# Set to 0 to disable. Start with 2–4 GB and benchmark throughput impact.
LLM_CPU_OFFLOAD_GB=0

# Compilation optimization level (0–3, default: 2).
#   0 — no compilation, fastest startup (~5s)
#   1 — basic optimizations
#   2 — standard compilation + CUDA graphs (default)
#   3 — aggressive torch.compile, recommended for production
# Level 3 adds 30–60s startup but improves decode throughput 10–20%.
# The one-time warmup cost is amortised over the container's lifetime.
LLM_OPTIMIZATION_LEVEL=3

# Maximum concurrent partial prefills during chunked prefill (default: 1).
# Higher values allow multiple sequences to prefill simultaneously, improving
# overall throughput when multiple requests arrive together.
# Trade-off: higher values increase activation memory per step.
# 1 is safest for memory-constrained setups; try 2 if VRAM allows.
LLM_MAX_NUM_PARTIAL_PREFILLS=1

# Requests with prompts longer than this are classified as "long" prefills
# (default: 0 = disabled). Long prefills are scheduled separately to avoid
# starving short requests. Set to e.g., 4096 to prioritise short-prompt TTFT.
LLM_LONG_PREFILL_TOKEN_THRESHOLD=6000

# =============================================================================
# Reasoning — Qwen3.6 <think>…</think> support
# =============================================================================

# Parser for <think>…</think> extraction. Use "qwen3" for Qwen 3.x models.
# Enables reasoning_content field in the OpenAI API response.
LLM_REASONING_PARSER=qwen3

# Tool call parser for automatic tool/function calling.
# Setting this enables --enable-auto-tool-choice automatically.
# Qwen3.x parsers: qwen3_xml (recommended), qwen3_coder (for Coder models).
LLM_TOOL_CALL_PARSER=qwen3_xml

# =============================================================================
# Speculative Decoding — MTP (Multi-Token Prediction)
#
# Qwen3.6-27B includes native MTP heads (trained in the checkpoint).
# MTP reduces time-per-output-token with ~70-85% acceptance rate.
# No separate draft model needed — zero extra weight VRAM.
#
# Trade-off: MTP improves single-request latency but reduces batch throughput
# because speculative tokens consume KV cache capacity.
# Each speculative token costs 64 KB raw (compressed ~13 KB with k4v2_nc).
# =============================================================================

# JSON config for vLLM's --speculative-config flag.
# method: "mtp" uses the model's native multi-token prediction heads.
# num_speculative_tokens:
#   1 = safest — minimal KV overhead (~13 KB/step), highest acceptance rate.
#       Best for memory-constrained setups. Still reduces TPOT ~40-50%.
#   2 = moderate — ~26 KB/step, good if acceptance stays >70%.
#   3 = aggressive — ~39 KB/step, diminishing returns if acceptance drops <60%.
# Leave empty to disable speculative decoding entirely.
LLM_SPECULATIVE_CONFIG={"method": "mtp", "num_speculative_tokens": 3}

# =============================================================================
# Model Download
# =============================================================================

# Required for gated/private HuggingFace models.
HF_TOKEN=

# =============================================================================
# Cloudflare Tunnel
# =============================================================================

# Token from Zero Trust → Networks → Tunnels → Create tunnel → Docker.
CF_TUNNEL_TOKEN=

# =============================================================================
# MCP Search Server
# =============================================================================

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=3100

SEARCH_ENGINE=duckduckgo
SEARCH_API_KEY=
BROWSER_TIMEOUT=30
MAX_RESULTS=10
CACHE_ENABLED=true
CACHE_TTL=3600

# Auto-generated by sync-env.py if empty.
MCP_API_KEY=

# Base URL for download links served by the MCP server.
FILE_BASE_URL=https://mcp.jessfan.com

# CORS origins for the MCP server.
MCP_CORS_ORIGINS=*

# =============================================================================
# Chat UI (ui/ — Vite dev server)
# =============================================================================

# Port the Vite dev server binds on the host.
CHAT_UI_PORT=5173

# Firebase project credentials (from Firebase Console → Project settings → Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated Firebase UIDs allowed to use the chat UI.
VITE_ADMIN_UID=

# =============================================================================
# Logging & Observability
# =============================================================================

# Set to 1 to disable per-request logging.
LLM_DISABLE_LOG_REQUESTS=
