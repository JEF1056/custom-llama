# llama.cpp Server Configuration
# Copy this file to .env and modify as needed.
# Run: python sync-env.py
#
# Model configuration (ctx, KV cache, sampling, speculative decoding, etc.)
# lives in config/models.ini → /etc/llama-server/models.ini inside the container.
# Edit that file to tune per-model or global parameters.

# =============================================================================
# Server
# =============================================================================

LLAMA_HOST=0.0.0.0
LLAMA_PORT=8080

# Optional API key — all requests must include Authorization: Bearer <key>.
LLAMA_API_KEY=

# =============================================================================
# Router Mode
# =============================================================================

# Maximum number of models loaded simultaneously (LRU eviction when exceeded).
# 1 = only one model hot at a time (recommended for RTX 3090 24GB).
LLAMA_MODELS_MAX=1

# Automatically load model instances on first request (vs. manual /models/load).
LLAMA_MODELS_AUTOLOAD=on

# =============================================================================
# Build
# =============================================================================

# Target CUDA architectures for the compiler. Fewer = faster builds.
# 86 = RTX 3090/3080, 89 = RTX 4090/4080, 90 = H100.
# Override: CUDA_ARCHS="86;89" for multi-GPU support.
CUDA_ARCHS=86

# =============================================================================
# CUDA Tuning (env vars, not CLI flags — apply to all modes)
# =============================================================================

# CUDA graphs ON/OFF. PRESENCE-ONLY in ggml: any value (even "0") turns CUDA
# graph capture/replay OFF. Graphs are now ENABLED for the qwopus 160k model:
# both out-of-band KV-mutation crash triggers are mitigated (compaction via
# ggml_backend_cuda_graph_clear in-source; checkpoint-write via single-stream
# graphs, see GGML_CUDA_GRAPH_OPT below). This var is therefore left UNSET (the
# docker-compose line is commented). To force graphs OFF as a fallback, set
# GGML_CUDA_DISABLE_GRAPHS=1 here AND uncomment the line in docker-compose
# (a host value alone can NOT toggle it — the map form always emits the key).
# GGML_CUDA_DISABLE_GRAPHS=1

# CUDA graph multi-stream concurrency optimization pass (atoi==1). MUST be 0 for
# this deployment: the multi-stream replay races the out-of-band checkpoint copy
# and causes the 160k illegal-memory-access crash (it is a RACE — confirmed
# clean under CUDA_LAUNCH_BLOCKING=1). With it off, graphs run single-stream and
# stay stable (validated at 160k). A no-op while graphs are disabled.
GGML_CUDA_GRAPH_OPT=0

# CUDA launch queue scaling. 2x is sufficient for RTX 3090 single-GPU workloads.
CUDA_SCALE_LAUNCH_QUEUES=2x

# =============================================================================
# Model Download / Conversion
# =============================================================================

# Required for gated / private HuggingFace models.
HF_TOKEN=

# Throttle downloads via curl --limit-rate (e.g. 300M). Empty = full speed.
CONVERT_DOWNLOAD_RATE=

# CPU threads for llama-quantize. Default: cpu_count // 2.
CONVERT_THREADS=

# =============================================================================
# Cloudflare Tunnel
# =============================================================================

# Token from Zero Trust → Networks → Tunnels → Create tunnel → Docker.
CF_TUNNEL_TOKEN=

# =============================================================================
# MCP Search Server
# =============================================================================

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=3100

SEARCH_ENGINE=duckduckgo
SEARCH_API_KEY=
BROWSER_TIMEOUT=30
MAX_RESULTS=10
CACHE_ENABLED=true
CACHE_TTL=3600

# Auto-generated by sync-env.py if empty.
MCP_API_KEY=

# Base URL for download links served by the MCP server.
FILE_BASE_URL=https://mcp.jessfan.com/files

# CORS origins for the MCP server.
MCP_CORS_ORIGINS=*

# =============================================================================
# Advisor (local LLM expert reasoning)
# =============================================================================

# The advisor tool calls the local LLM via OpenAI-compatible API for expert
# reasoning on complex problems.  Set these to match your llama.cpp endpoint.
ADVISOR_BASE_URL=http://localhost:8080/v1
ADVISOR_MODEL=qwopus3.6-27b
ADVISOR_API_KEY=
ADVISOR_MAX_TOKENS=8192

# =============================================================================
# Logging & Observability
# =============================================================================

# Log level for the LLM server (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
