# vLLM Server Configuration — Optimized for single RTX 3090 (24 GB)
# Copy this file to .env and modify as needed.
# Run: python sync-env.py

# =============================================================================
# vLLM Server
# =============================================================================

VLLM_HOST=0.0.0.0
VLLM_PORT=8080

# All requests must include Authorization: Bearer <key>.
VLLM_API_KEY=

# =============================================================================
# Model — Qwen3.6-27B AutoRound INT4 (~19 GB VRAM)
# =============================================================================

# Local directory containing safetensors weights.
VLLM_MODEL_PATH=/models/qwen3.6-27b-autoround

# Quantization format. AutoRound INT4 models are auto-detected from config;
# leave empty to let vLLM infer from the checkpoint's quantize_config.json.
VLLM_QUANTIZATION=

# Override tokenizer path; leave empty to use the one bundled with the model.
VLLM_TOKENIZER_PATH=

# Model alias returned by /v1/models and used in chat completion requests.
VLLM_SERVED_MODEL_NAME=qwen3.6-27b

# =============================================================================
# Inference — RTX 3090 24 GB budget
#
# Qwen3.6-27B architecture (from config.json):
#   64 layers total — hybrid gated delta-net:
#     48× linear attention (recurrent state, fixed-size, no per-token KV)
#     16× full attention   (standard KV cache, GQA: 4 KV heads × 256 head_dim)
#   Vision: 27-layer ViT encoder (1152 hidden → 5120 projection)
#
# VRAM budget breakdown:
#   Model weights (INT4 + scales/zeros):      ~15.5 GB
#     (27B × 0.5 B/param + ~15% group overhead)
#   Embeddings + LM head (BF16, not quantized): ~2.4 GB
#     (vocab 248320 × hidden 5120 × 2 bytes × 2)
#   Vision tower (BF16):                       ~0.4 GB
#   MTP heads (BF16):                          ~0.2 GB
#   Linear attn recurrent state (fixed):       ~0.1 GB
#     (48 layers × 16 key heads × 128 dim × ~128 state × 2 B)
#   CUDA context + activations (enforce_eager): ~0.5 GB
#   ─────────────────────────────────────────────────────
#   Total non-KV:                              ~19.1 GB
#
# KV cache math (only 16 full-attention layers cache KV):
#   Per token (BF16): 2 × 16 layers × 4 heads × 256 dim × 2 B = 65,536 B = 64 KB
#   Usable VRAM:      24 GB × 0.95 = 22.8 GB
#   KV budget (raw):  22.8 - 19.1 = 3.7 GB
#   Raw capacity:     3,700 MB / 0.0625 MB = ~59,200 tokens
#   With turboquant_4bit_nc (3.8×): 59,200 × 3.8 = ~225,000 tokens
#
# → 128K context fits with ~97K tokens of headroom at batch size 1.
#   At batch size 2, max ~112K tokens each. At batch size 4, max ~56K each.
# =============================================================================

# Maximum context window in tokens per request.
# Total KV capacity is ~225K tokens (3.7 GB × 3.8× TurboQuant / 64 KB per token).
# At max_num_seqs=2: 2 × 100K = 200K, well within 225K budget (~11% headroom).
VLLM_MAX_MODEL_LEN=100000

# Fraction of GPU VRAM allocated to model weights + KV cache (0.0–1.0).
# 0.95 → 22.8 GB usable, leaving 3.7 GB for KV cache (→ ~225K tokens compressed).
# Lower to 0.92 if you see OOM from activation spikes on very long sequences.
VLLM_GPU_MEMORY_UTILIZATION=0.95

# Maximum concurrent sequences in a batch.
# At 100K tokens × 64 KB/token / 3.8 = ~1.68 GB per sequence.
# Budget of 3.7 GB fits 2 full 100K sequences (1.68 × 2 = 3.37 GB, 11% headroom).
# Set to 4–8 if you lower max_model_len to 32768.
VLLM_MAX_NUM_SEQS=2

# Number of GPUs to shard the model across.
VLLM_TP_SIZE=1

# Weight precision: auto lets vLLM use the checkpoint's native dtype.
# INT4 AutoRound stores compute in float16 internally.
VLLM_DTYPE=auto

# KV cache quantization via TurboQuant (ICLR 2026, upstream since vLLM 0.20).
# Available presets:
#   turboquant_k8v4    — FP8 keys + 4-bit values, 2.6× compression, +1.17% PPL (recommended)
#   turboquant_4bit_nc — 4-bit keys + 4-bit values + NC, 3.8×, +2.71% PPL
#   turboquant_k3v4_nc — 3-bit keys + 4-bit values + NC, ~3.5×, +10.63% PPL (quality degrades)
#   fp8 / fp8_e5m2     — standard FP8, 2× compression, ~0% PPL impact
#   auto               — full precision (no compression)
#
# NOTE: SGLang's K4V2 preset does not exist in vLLM. turboquant_k8v4 is the
# closest: FP8 keys preserve attention quality while 4-bit values give 2.6×
# compression — the best quality/compression trade-off per vLLM's own benchmarks.
VLLM_KV_CACHE_DTYPE=turboquant_4bit_nc

# Maximum tokens in a single prefill batch step. Leave empty for vLLM default.
VLLM_MAX_NUM_BATCHED_TOKENS=

# Chunked prefill interleaves prefill and decode for better GPU utilisation.
# Recommended for long-context workloads on memory-constrained GPUs.
VLLM_ENABLE_CHUNKED_PREFILL=1

# Prefix caching reuses KV cache for repeated prompt prefixes.
# Disable when using MTP for latency-sensitive single-user workloads (MTP
# speculative tokens consume KV cache capacity, conflicting with prefix cache).
# Enable for multi-user / batch throughput scenarios.
VLLM_ENABLE_PREFIX_CACHING=

# Disable CUDA graph capture (saves ~1.5 GB VRAM, 10-30% slower decode).
# With only 16 full-attention layers (hybrid arch), CUDA graph overhead is lower
# than a pure transformer. Try empty first; set to 1 if OOM during graph capture.
# enforce_eager=1 would increase KV budget from 3.7 to ~5.2 GB (~315K tokens).
VLLM_ENFORCE_EAGER=

# Reduce CUDA allocator fragmentation under long-context workloads.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:512

# =============================================================================
# Scheduler
# =============================================================================

# Scheduling policy: fcfs (first-come-first-served) or priority.
VLLM_SCHEDULING_POLICY=

# =============================================================================
# Reasoning — Qwen3.6 <think>…</think> support
# =============================================================================

# Parser for <think>…</think> extraction. Use "qwen3" for Qwen 3.x models.
# Enables reasoning_content field in the OpenAI API response.
VLLM_REASONING_PARSER=qwen3

# =============================================================================
# Speculative Decoding — MTP (Multi-Token Prediction)
#
# Qwen3.6-27B includes native MTP heads (trained in the checkpoint).
# MTP-1 reduces time-per-output-token with ~70-85% acceptance rate.
# No separate draft model needed — zero extra VRAM.
#
# Trade-off: MTP improves single-request latency but reduces batch throughput
# because speculative tokens consume KV cache capacity.
# =============================================================================

# JSON config for vLLM's --speculative-config flag.
# method: "mtp" uses the model's native multi-token prediction heads.
# num_speculative_tokens: each speculative token costs 64 KB (compressed ~17 KB).
#   1 = safest, minimal KV overhead. 2 = higher throughput if acceptance stays >70%.
# Leave empty to disable speculative decoding entirely.
VLLM_SPECULATIVE_CONFIG={"method": "mtp", "num_speculative_tokens": 2}

# =============================================================================
# Model Download
# =============================================================================

# Required for gated/private HuggingFace models.
HF_TOKEN=

# =============================================================================
# Cloudflare Tunnel
# =============================================================================

# Token from Zero Trust → Networks → Tunnels → Create tunnel → Docker.
CF_TUNNEL_TOKEN=

# =============================================================================
# MCP Search Server
# =============================================================================

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=3100

SEARCH_ENGINE=duckduckgo
SEARCH_API_KEY=
BROWSER_TIMEOUT=30
MAX_RESULTS=10
CACHE_ENABLED=true
CACHE_TTL=3600

# Auto-generated by sync-env.py if empty.
MCP_API_KEY=

# Base URL for download links served by the MCP server.
FILE_BASE_URL=https://mcp.jessfan.com

# CORS origins for the MCP server.
MCP_CORS_ORIGINS=*

# =============================================================================
# Chat UI (ui/ — Vite dev server)
# =============================================================================

# Port the Vite dev server binds on the host.
CHAT_UI_PORT=5173

# Firebase project credentials (from Firebase Console → Project settings → Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated Firebase UIDs allowed to use the chat UI.
VITE_ADMIN_UID=

# =============================================================================
# Logging & Observability
# =============================================================================

# Set to 1 to disable per-request logging.
VLLM_DISABLE_LOG_REQUESTS=

