# llama.cpp Server Configuration
# Copy this file to .env and modify as needed.
# Run: cp .env.default .env
#
# Tuned for:  Intel i7-12700 | 32GB DDR4 | RTX 3090 24GB | Desktop (shared)

# =============================================================================
# Model Selection
# =============================================================================

# Automatic download + quantization on first start.
# QUANT accepts any standard quant (Q4_K_M, Q8_0, Q6_K, ...) or TurboQuant (TQ2_0, TQ1_0).
# If the requested quant is not pre-built on HuggingFace, the best available source
# (fp16 → bf16 → Q8_0 → ...) is downloaded, quantized locally, then deleted.
# On subsequent restarts the cached file is reused — no re-download.
MODEL_NAME=qwopus3.6-27b
QUANT=Q3_K_L

# Manual model override — skip MODEL_NAME auto-download and point directly at a
# .gguf file already present in the ./models volume mount.
# Set to the MTP GGUF produced by: convert-st qwopus3.6-27b --quant Q3_K_L --mtp
# Leave empty to fall back to MODEL_NAME+QUANT (prebuilt, no MTP).
LLAMA_MODEL=/models/qwopus3.6-27b-Q3_K_L-mtp.gguf

# =============================================================================
# Multimodal (Vision)
# =============================================================================

# Path to the mmproj file inside the container.
# When MODEL_NAME is set, manage_models.py auto-downloads the mmproj alongside
# the main model and places it at /models/<filename>.
LLAMA_MMPROJ=/models/qwopus3.6-27b-mmproj.gguf

# Static image to pre-load for multimodal input (optional).
LLAMA_IMAGE=

# =============================================================================
# Server
# =============================================================================

LLAMA_HOST=0.0.0.0
LLAMA_PORT=8080

# Optional API key — when set, all requests must include Authorization: Bearer <key>.
LLAMA_API_KEY=

# =============================================================================
# GPU / Context
# =============================================================================

# Offload all layers to GPU. llama.cpp clamps to the model's actual layer count.
LLAMA_GPU_LAYERS=99

# Context window in tokens — total pool shared across all parallel slots (--kv-unified).
# 150K shared: up to ~75K each when both slots are active concurrently, or the full
# 150K available to a single slot when the other is idle (cleared to --cache-ram).
#
# Qwopus3.6-27B architecture: HYBRID — 64 layers total, but only 16 are Gated Attention (with KV cache).
# Layout: 16 × (3 × Gated DeltaNet → FFN + 1 × Gated Attention → FFN)
#   - 48 DeltaNet layers: linear attention, fixed 898 MiB recurrent state, NO KV cache.
#   - 16 Attention layers: GQA, 24 Q heads / 4 KV heads / head_dim 256, standard KV cache.
# Runs in multimodal (vision) mode; mmproj is loaded alongside the main weights.
#
# VRAM budget (RTX 3090, 24 GB) — pessimistic:
#   model (Q3_K_L ~10.5 GB + mmproj 0.9 GB):  ~11.4 GB
#   DeltaNet recurrent state:                  ~0.9 GB  ← fixed 898 MiB regardless of ctx
#   KV cache (turbo3, 150K ctx):               ~0.9 GB  ← 2×16L×4KV×256D×150K×0.375 B
#   CUDA context + compute buffers:            ~0.6 GB
#   ─────────────────────────────────────────────────────
#   Total:                                    ~17.3 GB of 24 GB  (~6.7 GB headroom)
#
# System RAM budget (32 GB) — pessimistic:
#   OS + desktop processes:                    ~4.0 GB
#   Docker + container overhead:               ~0.5 GB
#   cache-ram (LLAMA_CACHE_RAM=4096):          ~4.0 GB  ← host prompt cache at capacity
#   llama.cpp CPU allocs + misc:               ~1.0 GB
#   ─────────────────────────────────────────────────
#   Total:                                    ~9.5 GB of 32 GB  (~22.5 GB headroom)
LLAMA_CTX_SIZE=150000

# Concurrent inference slots.
# With --kv-unified, PARALLEL controls max parallel jobs but no longer divides the context.
# MTP supports n_parallel > 1: each slot gets its own KV sequence in ctx_mtp.
LLAMA_PARALLEL=2

# =============================================================================
# CPU Threads
# =============================================================================

# i7-12700: 8 P-cores (16 HT threads) + 4 E-cores = 20 total.
# With full GPU offload, CPU only handles embedding/output layers — minimal work.
# --threads (-t):        decode threads; 6 leaves headroom for the desktop.
# --threads-batch (-tb): prefill graph scheduling; 8 reduces TTFT on i7-12700 P-cores.
LLAMA_THREADS=6
LLAMA_THREADS_BATCH=8

# =============================================================================
# Batch Processing
# =============================================================================

# --batch-size  (-b):  logical batch — tokens processed per prefill step.
# --ubatch-size (-ub): physical micro-batch per CUDA kernel call.
#   Reduce ubatch to 1024 only if you see OOM during long prompts.
LLAMA_BATCH_SIZE=4096
LLAMA_UBATCH_SIZE=2048

# =============================================================================
# KV Cache
# =============================================================================

# Cache quantization for K and V heads.
# Options: f16, q8_0, q4_0, turbo3 (3-bit), turbo4 (4-bit).
# turbo3 requires Flash Attention. Fall back to q8_0 for KV quality issues.
LLAMA_CACHE_TYPE_K=turbo3
LLAMA_CACHE_TYPE_V=turbo3

# Flash Attention: cuts KV memory 20–50% and improves prefill throughput on CUDA.
LLAMA_FLASH_ATTN=on

# on = --no-kv-offload (force KV on GPU). off = allow CPU fallback if VRAM is full.
LLAMA_NO_KV_OFFLOAD=off

# Unified KV cache across slots (--kv-unified).
# Shares the entire context pool among all parallel slots instead of dividing it per slot.
# Now the default in llama.cpp ≥ b4550 — setting explicitly is still good practice.
LLAMA_KV_UNIFIED=on

# Host-memory prompt cache size in MiB (--cache-ram).
# Slots whose KV state would otherwise be evicted are serialised to CPU RAM and
# hot-swapped back when prefix similarity makes it cheaper to restore than re-process.
# -1 = use all available host RAM. 0 = disable. Leave empty to omit the flag entirely.
# Sized for 100K ctx: 2 full slots × ~1.7 GiB each = ~3.4 GiB worst case; 4 GiB gives
# comfortable headroom for a few cached past conversations (prefix reuse across requests).
LLAMA_CACHE_RAM=6144

# Clear idle slots to host RAM on every new task (--clear-idle / --no-clear-idle).
# When a new request arrives, idle-slot KV cells are saved to --cache-ram and removed
# from VRAM, shrinking n_kv to only active tokens and cutting attention cost.
# Requires LLAMA_CACHE_RAM to be set (non-zero). +20–25 % on agentic workloads.
LLAMA_CLEAR_IDLE=on

# Directory where llama.cpp writes slot state files (KV cache persistence across restarts).
# Maps to ./models/slots on the host via the ./models volume.
LLAMA_SLOT_SAVE_PATH=/models/slots

# =============================================================================
# Context Checkpointing
# =============================================================================

# How often to snapshot KV state during prefill (tokens between checkpoints).
# Default 8192. With 150K ctx and long agentic sessions, wider intervals mean
# fewer serialization pauses. Each checkpoint = ~149 MiB memcpy to LLAMA_CACHE_RAM.
LLAMA_CHECKPOINT_EVERY_N_TOKENS=16384

# Max checkpoints kept per slot. Default 32.
# At 16384-token intervals across 150K ctx: ~9 checkpoints max needed.
# 16 gives comfortable headroom for both slots. Reduces worst-case RAM usage:
#   32 × 149 MiB × 2 slots = ~9.5 GiB  →  16 × 149 MiB × 1 slots = ~4.7 GiB
LLAMA_CTX_CHECKPOINTS=16

# =============================================================================
# Memory Mapping
# =============================================================================

# off = use mmap (OS loads pages on demand). on = load full model into RAM upfront.
LLAMA_NO_MMAP=off

# Direct I/O: bypass OS page cache when reading the model at load time.
# Recommended when ngl=99 — the model only needs reading once into VRAM.
LLAMA_DIRECT_IO=on

# =============================================================================
# Generation
# =============================================================================

# -1 = unlimited (generate until EOS or context full).
LLAMA_MAX_TOKENS=-1
LLAMA_TOP_P=0.95
LLAMA_TEMP=0.6
LLAMA_TOP_K=20
LLAMA_MIN_P=0.0
LLAMA_PRESENCE_PENALTY=0.0
LLAMA_REPETITION_PENALTY=1.0

# Stop sequences — tokens/strings that terminate generation (space-separated or JSON list).
LLAMA_STOP=

# =============================================================================
# Anti-loop / DRY Sampling
# =============================================================================

# presence_penalty and repetition_penalty are intentionally off (0.0 / 1.0) —
# they penalize individual repeated tokens, which corrupts tool-call JSON keys.
# DRY sampling is sequence-aware and only triggers on n-grams ≥ allowed_length+1:
#   dry_allowed_length=8: JSON key sequences (≤8 tokens) pass through unpenalized;
#     natural-language loops (10–25 tokens) get caught.
#   Reduce dry_penalty_last_n to 2048 if you see corrupted code output.
LLAMA_DRY_MULTIPLIER=0.4
LLAMA_DRY_BASE=1.75
LLAMA_DRY_ALLOWED_LENGTH=128
LLAMA_DRY_PENALTY_LAST_N=2048

# Hard cap on tokens inside <think>…</think> per turn.
LLAMA_REASONING_BUDGET=4096

# Enable for models trained with reasoning (Qwen, DeepSeek-R1, QwQ, etc.).
LLAMA_REASONING=on

# Keep prior <think> blocks in the prompt across turns.
# Prevents forgetting chain-of-thought and maximizes KV-cache prefix reuse.
# Requires LLAMA_REASONING=on; silently ignored by templates that don't support it.
LLAMA_PRESERVE_THINKING=on

# =============================================================================
# MTP (Multi-Token Prediction) Speculative Decoding
# =============================================================================

# MTP requires nextn tensors baked into the GGUF. The prebuilt GGUFs from Jackrong/Qwopus3.6-27B-v1-preview-GGUF
# strip MTP heads. Produce an MTP-capable GGUF from safetensors via:
#   docker compose run --rm llama-convert convert-st qwopus3.6-27b --quant Q3_K_L --mtp
# Output: /models/qwopus3.6-27b-Q3_K_L-mtp.gguf
# Then set LLAMA_MODEL and LLAMA_SPEC_TYPE below (keep QUANT/MODEL_NAME for non-MTP fallback):
#   LLAMA_MODEL=/models/qwopus3.6-27b-Q3_K_L-mtp.gguf
#   LLAMA_SPEC_TYPE=mtp
LLAMA_SPEC_TYPE=mtp
LLAMA_SPEC_DRAFT_N_MAX=3

# =============================================================================
# Multi-GPU / MoE
# =============================================================================

# Tensor split across GPUs (e.g., "13,14" for two GPUs). Leave empty for single GPU.
LLAMA_TS=

# Number of MoE experts to offload to CPU. Leave empty for full GPU fit.
LLAMA_NCMOE=

# =============================================================================
# Model Conversion / Quantization
# =============================================================================

# Throttle downloads via curl --limit-rate (e.g. 300M = 300 MB/s).
# Leave empty for full speed. Lower if CLOCK_WATCHDOG_TIMEOUT BSODs on Windows/WSL2.
CONVERT_DOWNLOAD_RATE=
# CONVERT_DOWNLOAD_RATE=300M

# CPU threads for llama-quantize. Default: cpu_count // 2.
# Lower if BSODs occur during quantization on Windows/WSL2.
CONVERT_THREADS=
# CONVERT_THREADS=4

# =============================================================================
# HuggingFace
# =============================================================================

# Required for gated / private models.
HF_TOKEN=

# =============================================================================
# Cloudflare
# =============================================================================

# Token from Zero Trust → Networks → Tunnels → Create tunnel → Docker.
# Public Hostname: api.jessfan.com → http://llama-server:8080
CF_TUNNEL_TOKEN=

# Hostname protected by Cloudflare Access. Leave empty to disable.
CF_ACCESS_HOSTNAME=

# Google OAuth credentials for Cloudflare Access. Leave empty to use email auth.
CF_ACCESS_GOOGLE_CLIENT_ID=
CF_ACCESS_GOOGLE_CLIENT_SECRET=

# =============================================================================
# MCP Search Server
# =============================================================================

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=3100

# Search engine: duckduckgo, serpapi, google
SEARCH_ENGINE=duckduckgo

# API key for SerpAPI (https://serpapi.com/manage-api-key). Leave empty for DuckDuckGo.
SEARCH_API_KEY=

BROWSER_TIMEOUT=30
MAX_RESULTS=10
CACHE_ENABLED=true

# Cache TTL in seconds.
CACHE_TTL=3600
