# Copy to .env and edit.

# Auth key clients must present to the router (Authorization: Bearer ...).
LITELLM_MASTER_KEY=sk-local-master-change-me

# OpenAI-compatible base URLs of the two backends (note the /v1 suffix).
CUDA_BACKEND_URL=http://192.168.1.50:8080/v1
MAC_BACKEND_URL=http://192.168.1.20:8081/v1

# The backends don't require auth; any non-empty value works.
BACKEND_API_KEY=sk-noauth
