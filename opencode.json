{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["github:JEF1056/harness"],
  "provider": {
    "llama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-local",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "qwen36-262k-balanced": {
          "name": "Qwen3.6-35B-A3B 262K-Balanced",
          "tools": true,
          "attachment": true,
          "limit": {
            "context": 229376,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "llama-local/qwen36-262k-balanced",
  "mcp": {
    "websearch": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "websearch-mcp"],
      "environment": {
        "API_URL": "http://localhost:3001",
        "MAX_SEARCH_RESULT": "5"
      }
    }
  }
}
