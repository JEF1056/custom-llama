{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp Server",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "headers": {
          "X-Context-Limit": "100000",
          "X-Context-Window": "100000",
          "X-Context-Compact": "true"
        }
      },
      "models": {
        "qwenopus3.6-27b": {
          "name": "Qwopus3.6",
          "context": 100000
        }
      }
    }
  },
  "mcp": {
    "search tools": {
      "type": "remote",
      "url": "http://localhost:3100/mcp",
      "enabled": true
    }
  }
}