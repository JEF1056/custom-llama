{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["github:JEF1056/harness"],
  "provider": {
    "router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vllm-router",
      "options": {
        "baseURL": "http://coolify:4000/v1",
        "apiKey": "router-master-key"
      },
      "models": {
        "qwen3.6-35b": {
          "name": "Qwen3.6-35B-A3B (vLLM Router)",
          "tools": true,
          "attachment": true,
          "limit": {
            "context": 229376,
            "output": 8192
          }
        }
      }
    },
    "llama-remote": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-remote",
      "options": {
        "baseURL": "http://ml-2:8081/v1",
        "apiKey": "sk-noauth"
      },
      "models": {
        "/Users/jfan/.qwen/models/qwen36-mlx": {
          "name": "Qwen3.6-35B-A3B 262K-Remote",
          "tools": true,
          "attachment": true,
          "limit": {
            "context": 229376,
            "output": 8192
          }
        }
      }
    },
    "llama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-local",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "qwen36-262k-local": {
          "name": "Qwen3.6-35B-A3B 262K-Local",
          "tools": true,
          "attachment": true,
          "limit": {
            "context": 229376,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "router//qwen3.6-35b",
  "mcp": {
    "websearch": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "websearch-mcp"],
      "environment": {
        "API_URL": "http://localhost:3001",
        "MAX_SEARCH_RESULT": "5"
      }
    },
    "router": {
      "type": "remote",
      "enabled": true,
      "url": "http://100.81.0.46:4000/mcp",
      "headers": {
        "Authorization": "Bearer router-master-key"
      }
    }
  }
}
