# Copy to .env and edit. See docs/iqllama-migration-plan.md for full rationale.

# CUDA graph diagnostics (see ggml/src/ggml-cuda.cu g_cuda_graph_diag).
# GGML_CUDA_GRAPH_DIAG=1 prints a summary to stderr every
# GGML_CUDA_GRAPH_DIAG_INTERVAL (default 500) graph_compute() calls.
# MTP off: graphs work ~99% of the time. MTP on: broken for nearly every
# decode call because MTP's batch size 2 (draft+verify) conflicts with
# GGML_OP_MOE_FUSED_UP_GATE's CUDA-graph path (hardcoded to batch size 1).
GGML_CUDA_GRAPH_DIAG=1
GGML_CUDA_GRAPH_DIAG_INTERVAL=200

# Hugging Face read token. Only needed if HF_REPO/MMPROJ download is gated, or
# when using MODEL_SOURCE=hf against a private repo. Public repos (e.g. the
# default llmfan46/Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-GGUF)
# work without one.
QWEN_TOKEN=

# Host/container port for the OpenAI-compatible API.
PORT=8080

# Host port for the dev compose stack (docker/docker-compose.yml). Distinct
# from prod's PORT above so both stacks can run simultaneously without a
# collision. Defaults to 8081 if unset.
DEV_PORT=8080

# --- Model source --------------------------------------------------------
# local (default): our in-house "262K-Balanced" GGUF (Phase 2/4), produced by
#   scripts/quantize.sh, mounted from the qwen36-models volume.
# hf: pull a public GGUF from Hugging Face via -hf/-hff for bring-up/smoke-tests.
MODEL_SOURCE=local
GGUF_FILE=qwen36-262k-balanced.gguf
# hf-mode source: llmfan46's abliterated Qwen3.6 GGUF with native MTP preserved.
# Set HF_FILE to one of its pre-made quants (e.g. *-Q4_K_M.gguf) for bring-up.
HF_REPO=llmfan46/Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-GGUF
HF_FILE=

# Context window in tokens. Default = model's full native 262144 (262K).
# CTX=0 lets ik_llama auto-fit context to available VRAM. Lowered to 229376
# (262144 * 7/8) after WSL2 OOM investigation: the 24GB WSL2 VM's swap is
# not actually mounted, so nothing bounds worst-case host RAM. This trims
# the ceiling ~12.5%.
CTX=229376

# KV-cache data type for the 10 full-attention layers (the 30 DeltaNet layers
# use a fixed-size recurrent state, independent of context length/KV type).
KV_TYPE=q4_0

# Hadamard-rotate the K/V cache before quantizing (reduces quantization error;
# Qwen3.6's attention head_dim=256 is power-of-2 compatible). Set 0 to disable.
KV_HADAMARD=1

# Prompt caching: context-checkpoint + prompt-state cache (full sequence-state
# save/restore). RAM budget in MiB (-1 = no limit, 0 = disable). Lowered from
# 8192 -> 4096 after WSL2 OOM: each ~150-200k-token request serializes to
# ~1-1.7GB; running several back-to-back accumulated past the 24GB WSL2 VM's
# ceiling (swap not mounted). 4096 caps worst-case to ~2-3 cached states.
CACHE_RAM_MIB=4096

# Concurrent request slots. The server splits KV context evenly across slots,
# so N_PARALLEL slots cap a single sequence to CTX / N_PARALLEL tokens. Keep
# at 1 for a single long (100K+ token) sequence; raise for concurrent shorter
# requests.
N_PARALLEL=1

# Model-loading memory behavior (--no-mmap / --mlock). Since the model is
# fully GPU-offloaded, these mainly affect load-time RAM staging, not
# steady-state decode throughput. USE_MLOCK=1 needs the container to have a
# raised locked-memory ulimit (docker-compose.yml's `ulimits: memlock`) or
# llama-server will fail to lock and error/warn depending on build - test
# before enabling in production. Both default off.
DISABLE_MMAP=0
USE_MLOCK=0
# Physical batch size (-ub): raises prompt-processing throughput at the cost
# of VRAM for compute buffers; generation speed is unaffected. Tuned on RTX 3090
# (see qwen36-bench-results.md): 1024 gives +24% prompt tok/s over default 512
# for ~500MiB more VRAM. 1024 chosen: 2048 crashed under long-context prefill
# (CUDA pool-growth margin too thin even after freeing VRAM via mmproj quant);
# the fix requires lowering CTX, not one-off savings. Do not retry 2048 without
# first cutting CTX enough to leave >=1.5-2GB free at load. Lower toward 256
# if a larger quant leaves little VRAM headroom; raise toward 2048 for smaller.
UBATCH_SIZE=2048
# Vision (multimodal). Qwen3.6-35B-A3B ships a Qwen3-VL-lineage vision tower as
# a separate mmproj GGUF. ENABLE_VISION=1 (default) serves image input; set 0
# for text-only. MMPROJ_FILE is the filename under /models (local) or HF_REPO (hf).
# Default: Q8_0-quantized (~276MiB less VRAM than BF16, 861->586MiB), validated
# with no observed vision-quality regression. Set to mmproj-BF16.gguf for original.
ENABLE_VISION=1
MMPROJ_FILE=mmproj-Q8_0.gguf

# MTP self-speculative decoding. No separate draft file - trailing MTP
# layer(s) are baked into the same GGUF. On this WSL2 box, MTP fits in VRAM
# but is slower end-to-end than no-MTP (each draft head is a full serial
# decode->sample->D2H round-trip, costing ~same latency as target decode
# despite tiny compute). Best config: N_MAX=2,p_min=0.5 (1432 round-trips,
# 86.2 tok/s). Try ENABLE_MTP=1 only if you have headroom and benchmark
# before/after - may be a net win on bare-metal Linux (lower sync overhead).
ENABLE_MTP=1
MTP_N_MAX=2
# p_min=0.0 makes prob_ptr NULL, permanently disabling the per-head early-exit
# confidence check (common/speculative.cpp: `prob_ptr = p_min > 0 ? &prob : nullptr`).
# Forces every token through all n_max sequential draft round-trips, even when
# confidence craters. Measured: raising p_min 0.0->0.5 nearly doubled throughput
# (~42 -> ~70 tok/s). Keep >0 if ENABLE_MTP=1.
MTP_P_MIN=0.5
# Optionally requantize the MTP output head independently (e.g. iq5_ks to
# raise draft acceptance). Empty = use the GGUF's baked-in precision.
MTP_REQUANTIZE_OUTPUT_TYPE=q8_0

# Optional n-gram lookup drafter, chained as a fast/free first speculative
# stage ahead of MTP (`--spec-type ngram-mod:... --spec-type mtp:...`). Costs
# no extra model inference - pure string matching against context.
# Optimal for coding + general language: large table captures code patterns,
# N_MAX=4 chains 4-token drafts, N_MIN=2 catches short snippets (braces, quotes).
# BUG: with vision enabled, the two-stage chain silently disables ALL speculative
# decoding (server-context.cpp whitelists only zero or single-MTP stages).
# Default OFF; only enable on text-only (ENABLE_VISION=0) - note that path
# has its own bug (`--no-mmproj` unrecognized) in this build.
ENABLE_NGRAM=1
NGRAM_TYPE=ngram-mod
NGRAM_N_MAX=16
NGRAM_N_MIN=2
NGRAM_SIZE_N=1024

# Sampling defaults (clients can override per request).
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.0

# Cap reasoning/thinking length; empty = unlimited.
REASONING_BUDGET=4096

# Preserve prior-turn <think> blocks when re-rendering the chat. Set 0 to strip.
PRESERVE_THINKING=1

# Optional prompt-cache slot directory (persist reusable KV slots to disk).
SLOT_SAVE_PATH=

# Space-separated extra llama-server flags for advanced tuning.
EXTRA_ARGS=

# --- Build-time (only used by `docker compose build`) ------------------------
# Fork/branch to compile, GPU arch (86 = RTX 3090).
LLAMA_REPO=https://github.com/ikawrakow/ik_llama.cpp.git
LLAMA_REF=main
CUDA_ARCH=86
CUDA_VERSION=13.3.0
