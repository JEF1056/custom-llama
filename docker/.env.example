# Copy to .env and edit. Required: BONSAI_TOKEN.

# Hugging Face read token (the Bonsai-27B repo is currently private).
BONSAI_TOKEN=hf_your_read_token_here

# Host/container port for the OpenAI-compatible API.
PORT=8080

# Context window in tokens. Default = the model's full 262144 (262K). With the
# quantized KV cache this fits on the 3090's 24 GB. Set CTX=0 for auto-fit.
CTX=262144

# KV-cache data type. q4_0 is the safe ~4-bit default. The fork also offers
# TurboQuant KV (turbo4 / turbo3 / turbo2) for higher quality at similar or
# smaller size - set KV_TYPE=turbo4 to use it.
KV_TYPE=q4_0

# Prompt caching. Bonsai is a hybrid (GDN + attention) arch, so llama.cpp
# auto-disables --cache-reuse (KV shifting) on it; the mechanism that works is
# the server's context checkpoints + prompt-state cache (on by default). This
# sets its RAM budget in MiB (-1 = no limit, 0 = disable). It is the same
# machinery DSpark speculative decoding reuses, so prompt caching and DSpark
# spec decode coexist - no trade-off.
CACHE_RAM_MIB=8192

# Vision (multimodal). Bonsai ships a separate vision tower as an mmproj GGUF,
# which the fork loads through the existing Qwen3-VL projector. ENABLE_VISION=1
# (default) serves image input; set 0 for a leaner text-only server that skips
# the ~629 MB mmproj download. MMPROJ_FILE picks the pack - the Q8_0 container
# holds the HQQ 4-bit tower; -mmproj-BF16.gguf is the higher-precision reference.
ENABLE_VISION=1
MMPROJ_FILE=Bonsai-27B-mmproj-Q8_0.gguf

# DSpark speculative decoding. Downloads the separate ~1.79 GB Q4_1 drafter and
# runs it as the draft model (--spec-type draft-dspark). Rides the same cache
# machinery as prompt caching, so both run together. Set 0 to disable, or point
# DSPARK_DRAFT_FILE at a different drafter pack.
ENABLE_DSPARK=1
DSPARK_DRAFT_FILE=Bonsai-27B-dspark-Q4_1.gguf

# Server-wide default cap on "thinking" tokens for clients that don't specify a
# reasoning effort. Empty = unlimited.
REASONING_BUDGET=2048

# Optional: directory (inside the volume) to persist reusable prompt-cache KV
# slots to disk. Empty = disabled.
SLOT_SAVE_PATH=/workspace/slots

# --- Build-time (only used by `docker compose build`) ------------------------
# Which fork/branch to compile and which GPU arch to target (86 = RTX 3090). The
# dspark-integration branch contains the DSpark drafter + server capture wiring.
LLAMA_REPO=https://github.com/JEF1056/llama-cpp-turboquant.git
LLAMA_REF=dspark-integration
CUDA_ARCH=86

# Advanced: extra space-separated flags forwarded to llama-server.
EXTRA_ARGS=
