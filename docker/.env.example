# Copy to .env and edit. See docs/iqllama-migration-plan.md for full rationale.

# CUDA graph diagnostics (see ggml/src/ggml-cuda.cu g_cuda_graph_diag).
# GGML_CUDA_GRAPH_DIAG=1 prints a summary to stderr every
# GGML_CUDA_GRAPH_DIAG_INTERVAL (default 500) graph_compute() calls.
# MTP off: graphs work ~99% of the time. MTP on: broken for nearly every
# decode call because MTP's batch size 2 (draft+verify) conflicts with
# GGML_OP_MOE_FUSED_UP_GATE's CUDA-graph path (hardcoded to batch size 1).
GGML_CUDA_GRAPH_DIAG=1
GGML_CUDA_GRAPH_DIAG_INTERVAL=200

# Hugging Face read token. Only needed if HF_REPO/MMPROJ download is gated, or
# when using MODEL_SOURCE=hf against a private repo. Public repos (e.g. the
# default llmfan46/Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-GGUF)
# work without one.
QWEN_TOKEN=

# Host/container port for the OpenAI-compatible API.
PORT=8080

# Host port for the dev compose stack (docker/docker-compose.yml). Distinct
# from prod's PORT above so both stacks can run simultaneously without a
# collision. Defaults to 8081 if unset.
DEV_PORT=8080

# --- Model source --------------------------------------------------------
# local (default): our in-house "262K-Balanced" GGUF (Phase 2/4), produced by
#   scripts/quantize.sh, mounted from the qwen36-models volume.
# hf: pull a public GGUF from Hugging Face via -hf/-hff for bring-up/smoke-tests.
MODEL_SOURCE=local
GGUF_FILE=qwen38-27b-heretic-ara-iq4_kss.gguf
HF_REPO=trohrbaugh/Qwen3.8-27B-heretic-ara
HF_FILE=

# Context window in tokens (160000 = 160K context window).
CTX=160000

# KV-cache data type for the full-attention layers
KV_TYPE=q4_0

# Hadamard-rotate the K/V cache before quantizing (reduces quantization error;
# Qwen3.6's attention head_dim=256 is power-of-2 compatible). Set 0 to disable.
KV_HADAMARD=1

# Prompt caching: context-checkpoint + prompt-state cache (full sequence-state
# save/restore). RAM budget in MiB (-1 = no limit, 0 = disable).
CACHE_RAM_MIB=1024
CTX_CHECKPOINTS_N=4
CTX_CHECKPOINTS_INTERVAL=8192

# Concurrent request slots. The server splits KV context evenly across slots.
# Set N_PARALLEL=1 for single sequence 128K context.
N_PARALLEL=1

# Model-loading memory behavior (--no-mmap / --mlock).
DISABLE_MMAP=0
USE_MLOCK=0

# Physical & logical batch sizes
BATCH_SIZE=4096
UBATCH_SIZE=1024

# Vision (multimodal). Set 0 for text-only server (preserves full VRAM and multi-stage speculation).
ENABLE_VISION=0
MMPROJ_FILE=mmproj-Q8_0.gguf

# Jinja templating & tool calling engine
ENABLE_JINJA=1

# --- DFlash Speculative Decoding -----------------------------------------
ENABLE_DFLASH=0
DFLASH_REPO=z-lab/Qwen3.8-27B-DFlash2-GGUF
DFLASH_FILE=Qwen3.8-27B-DFlash2-iq4_kss.gguf
DFLASH_N_MAX=3
DFLASH_P_MIN=0.0

# --- Two-Stage Speculative Decoding (Tuned for single 24GB RTX 3090) ---
# Stage 1: N-gram context matcher (CPU lookup, zero VRAM cost)
ENABLE_NGRAM=1
NGRAM_TYPE=ngram-mod
NGRAM_N_MAX=4
NGRAM_N_MIN=2
NGRAM_SIZE_N=16

# Stage 2: MTP neural head fallback
ENABLE_MTP=1
MTP_N_MAX=3
MTP_P_MIN=0.0
MTP_REQUANTIZE_OUTPUT_TYPE=iq4_kss

# Reasoning routing (thinking gate)
REASONING=off
REASONING_FORMAT=deepseek

# Sampling defaults (clients can override per request).
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.0

# Cap reasoning/thinking length; empty = unlimited.
REASONING_BUDGET=4096

# Preserve prior-turn <think> blocks when re-rendering the chat. Set 0 to strip.
PRESERVE_THINKING=1

# Optional prompt-cache slot directory (persist reusable KV slots to disk).
SLOT_SAVE_PATH=

# Space-separated extra llama-server flags for advanced tuning.
EXTRA_ARGS=

# --- Build-time (only used by `docker compose build`) ------------------------
# Fork/branch to compile, GPU arch (86 = RTX 3090).
LLAMA_REPO=https://github.com/ikawrakow/ik_llama.cpp.git
LLAMA_REF=main
CUDA_ARCH=86
CUDA_VERSION=13.3.0
