# Copy to .env and edit. All values have working defaults; the prism-ml
# Bonsai-27B GGUF repos are public, so no token is required to get started.

# Hugging Face read token. Leave empty for the public prism-ml GGUF repos; set a
# read token only if you point HF_REPO at a gated or private repo.
BONSAI_TOKEN=

# Host/container port for the OpenAI-compatible API.
PORT=8080

# Context window in tokens. Default = the model's full 262144 (262K). With the
# quantized KV cache this fits on the 3090's 24 GB. Set CTX=0 for auto-fit.
CTX=262144

# KV-cache data type. q4_0 is the safe ~4-bit default. The fork also offers
# TurboQuant KV (turbo4 / turbo3 / turbo2) for higher quality at similar or
# smaller size - set KV_TYPE=turbo4 to use it.
KV_TYPE=q4_0

# Prompt caching. Bonsai is a hybrid (GDN + attention) arch, so llama.cpp
# auto-disables --cache-reuse (KV shifting) on it; the mechanism that works is
# the server's context checkpoints + prompt-state cache (on by default). This
# sets its RAM budget in MiB (-1 = no limit, 0 = disable). It is the same
# machinery DSpark speculative decoding reuses, so prompt caching and DSpark
# spec decode coexist - no trade-off.
CACHE_RAM_MIB=8192

# Vision (multimodal). Bonsai ships a separate vision tower as an mmproj GGUF,
# which the fork loads through the existing Qwen3-VL projector. ENABLE_VISION=1
# (default) serves image input; set 0 for a leaner text-only server that skips
# the ~629 MB mmproj download. MMPROJ_FILE picks the pack - the Q8_0 container
# holds the HQQ 4-bit tower; -mmproj-BF16.gguf is the higher-precision reference.
ENABLE_VISION=1
MMPROJ_FILE=Bonsai-27B-mmproj-Q8_0.gguf

# DSpark speculative decoding. Downloads the separate ~1.79 GB Q4_1 drafter and
# runs it as the draft model (--spec-type draft-dspark). Rides the same cache
# machinery as prompt caching, so both run together. Set 0 to disable, or point
# DSPARK_DRAFT_FILE at a different drafter pack.
# Requires the fork fix in server_n_outputs_max (the decode output reserve is
# sized to n_batch when dspark is active); rebuild the image after pulling it.
ENABLE_DSPARK=1
DSPARK_DRAFT_FILE=Bonsai-27B-dspark-Q4_1.gguf
# dspark draft length; keep at the drafter block_size (4 for Bonsai-27B). Do NOT
# inflate it -- large values blow up the n_max-sized buffers into a load-time OOM.
DSPARK_N_MAX=4

# Opt-in per-round timing for the dspark speculative loop. When 1, the server
# logs "[dspark-prof] per round avg: draft=.. tgt_sync_wait=.. host_sample_accept=..
# ckpt_save=.." every 64 verify rounds to localize where the spec loop spends
# time (visible in `docker logs bonsai-cuda`). Leave unset/0 for production.
LLAMA_DSPARK_PROFILE=0

# Opt-in host-side top-K pre-truncation for the speculative verify sampler. When
# >0, the verify path selects the top-K logits (by raw value) before running the
# CPU sampler chain (DRY/repeat penalties + top_k/top_p/min_p), instead of the full
# ~150K vocab. The chain is monotone-shrinking so this is selection-identical while
# cutting host_sample_accept. Skipped automatically when a grammar, xtc, mirostat,
# or n_probs>K is in use. 256 is a safe default; 0 disables.
LLAMA_DSPARK_VERIFY_TOPK=0

# Opt-in ON-DEVICE (GPU) top-K for the speculative verify sampler. When >0, the
# backend computes top-K token ids over the full verify logits (single ggml_top_k)
# and the host sampler looks up their logit values from the resident logits buffer,
# skipping the O(n_vocab) host scan that LLAMA_DSPARK_VERIFY_TOPK still pays. Same
# monotone-shrinking correctness guard (applied host-side). Falls back to the
# host-side path per-row when the backend did not produce candidates. 0 disables.
LLAMA_DSPARK_VERIFY_TOPK_GPU=0

# reasoning effort. Empty = unlimited.
REASONING_BUDGET=2048

# Default sampling params (clients may override per request). Lower temperature
# raises DSpark draft acceptance since the drafter proposes near-greedily.
# The 1-bit quant is prone to verbatim repetition loops, so a modest repeat
# penalty (1.1) plus the DRY sampler (see EXTRA_ARGS) are enabled by default;
# DRY only fires once a real repeat starts, so it barely affects normal output
# or DSpark acceptance. Set REPEAT_PENALTY=1.0 / drop the DRY flags to disable.
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.1

# Optional: directory (inside the volume) to persist reusable prompt-cache KV
# slots to disk. Empty = disabled.
SLOT_SAVE_PATH=/workspace/slots

# --- Build-time (only used by `docker compose build`) ------------------------
# Which fork/branch to compile and which GPU arch to target (86 = RTX 3090). The
# dspark-integration branch contains the DSpark drafter + server capture wiring.
LLAMA_REPO=https://github.com/JEF1056/llama-cpp-turboquant.git
LLAMA_REF=dspark-integration
CUDA_ARCH=86

# Advanced: extra space-separated flags forwarded to llama-server.
# DRY sampler defaults below are the main loop-breaker for the 1-bit model.
# allowed-length 4 (vs the stock 2) keeps DRY from penalizing the short,
# legitimately-repeated token runs in tool-call JSON / code; its default
# sequence breakers already reset on " and : so JSON keys/values stay intact,
# and --jinja grammar-constrains tool calls so structure can't be corrupted.
EXTRA_ARGS=--dry-multiplier 0.8 --dry-base 1.75 --dry-allowed-length 4 --dry-penalty-last-n 1024
