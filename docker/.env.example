# Copy to .env and edit. See docs/iqllama-migration-plan.md for full rationale.

# Hugging Face read token. Only needed if HF_REPO/MMPROJ download is gated, or
# when using MODEL_SOURCE=hf against a private repo. Public repos (e.g. the
# default unsloth/Qwen3.6-35B-A3B-GGUF) work without one.
QWEN_TOKEN=

# Host/container port for the OpenAI-compatible API.
PORT=8080

# --- Model source --------------------------------------------------------
# local (default): our in-house "262K-Balanced" GGUF (docs/
#   iqllama-migration-plan.md Phase 2/4), produced offline by scripts/quantize.sh
#   and placed at /models/<GGUF_FILE> (mounted from the qwen36-models volume).
# hf: pull a public GGUF straight from Hugging Face via -hf/-hff instead -
#   useful for bring-up/smoke-testing the engine before our own recipe exists.
MODEL_SOURCE=local
GGUF_FILE=qwen36-262k-balanced.gguf
HF_REPO=unsloth/Qwen3.6-35B-A3B-MTP-GGUF
HF_FILE=

# Context window in tokens. Default = the model's full native 262144 (262K).
# Set CTX=0 to let ik_llama auto-fit context to available VRAM instead.
CTX=262144

# KV-cache data type for the 10 full-attention layers (the 30 DeltaNet layers
# use a fixed-size recurrent state, independent of context length/KV type).
KV_TYPE=q4_0

# Hadamard-rotate the K/V cache before quantizing (reduces quantization error;
# Qwen3.6's attention head_dim=256 is power-of-2 compatible). Set 0 to disable.
KV_HADAMARD=1

# Prompt caching: the server's context-checkpoint + prompt-state cache (full
# sequence-state save/restore), on by default. RAM budget in MiB
# (-1 = no limit, 0 = disable).
CACHE_RAM_MIB=8192

# Concurrent request slots. The server splits KV context evenly across slots,
# so N_PARALLEL slots cap a single sequence to CTX / N_PARALLEL tokens. Keep
# at 1 for a single long (100K+ token) sequence; raise for concurrent shorter
# requests.
N_PARALLEL=1
# Physical batch size (-ub): raises prompt-processing throughput at the cost
# of VRAM for compute buffers; generation speed is unaffected. Empirically
# tuned on a single RTX 3090 (see docs/qwen36-bench-results.md): 1024 gives
# +24% prompt tok/s over the ik_llama.cpp default of 512 for only ~500MiB
# more VRAM. Lower toward 256 if a larger quant leaves little VRAM headroom;
# raise toward 2048 if a smaller quant has room to spare.
UBATCH_SIZE=1024
# Vision (multimodal). Qwen3.6-35B-A3B ships a Qwen3-VL-lineage vision tower as
# a separate mmproj GGUF. ENABLE_VISION=1 (default) serves image input; set 0
# for a leaner text-only server. MMPROJ_FILE is the filename under /models
# (MODEL_SOURCE=local) or in HF_REPO (MODEL_SOURCE=hf).
ENABLE_VISION=1
MMPROJ_FILE=mmproj-BF16.gguf

# MTP self-speculative decoding. No separate draft file - the trailing MTP
# layer(s) are baked into the same GGUF. Enabled by default; set 0 to disable.
ENABLE_MTP=1
MTP_N_MAX=4
MTP_P_MIN=0.0
# Optionally requantize the MTP output head independently (e.g. iq5_ks to
# raise draft acceptance). Empty = use the GGUF's baked-in precision.
MTP_REQUANTIZE_OUTPUT_TYPE=

# Optional n-gram lookup drafter, chained as a fast/free first speculative
# stage ahead of MTP (--spec-type ngram-mod:... --spec-type mtp:...). Costs no
# extra model inference - pure string matching against context - so it's a
# free win on repeated/templated spans (long docs, code, boilerplate), while
# MTP still handles the harder/novel spans.
# CONFIRMED BUG on real hardware: with vision enabled (ENABLE_VISION=1, the
# default), this two-stage chain silently disables ALL speculative decoding
# ("speculative decoding is not supported by multimodal") - a single mtp
# stage alone works fine, only the chain breaks. Default OFF; only enable on
# a text-only deployment (ENABLE_VISION=0) - and note ENABLE_VISION=0 hits
# its own separate pre-existing bug in this build (--no-mmproj unrecognized).
ENABLE_NGRAM=0
NGRAM_TYPE=ngram-mod
NGRAM_N_MAX=64
NGRAM_N_MIN=2
NGRAM_SIZE_N=8

# Sampling defaults (clients can override per request).
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.0

# Cap reasoning/thinking length; empty = unlimited.
REASONING_BUDGET=

# Preserve prior-turn <think> blocks when re-rendering the chat. Set 0 to strip.
PRESERVE_THINKING=1

# Optional prompt-cache slot directory (persist reusable KV slots to disk).
SLOT_SAVE_PATH=

# Space-separated extra llama-server flags for advanced tuning.
EXTRA_ARGS=

# --- Build-time (only used by `docker compose build`) ------------------------
# Which fork/branch to compile and which GPU arch to target (86 = RTX 3090).
LLAMA_REPO=https://github.com/ikawrakow/ik_llama.cpp.git
LLAMA_REF=main
CUDA_ARCH=86
