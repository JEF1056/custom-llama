# Copy to .env and edit. See docs/iqllama-migration-plan.md for full rationale.

# CUDA graph diagnostics (see ggml/src/ggml-cuda.cu g_cuda_graph_diag).
# GGML_CUDA_GRAPH_DIAG=1 prints a summary to stderr every
# GGML_CUDA_GRAPH_DIAG_INTERVAL (default 500) graph_compute() calls.
GGML_CUDA_GRAPH_DIAG=1
GGML_CUDA_GRAPH_DIAG_INTERVAL=200

# Hugging Face read token. Only needed if HF_REPO/MMPROJ download is gated, or
# when using MODEL_SOURCE=hf against a private repo.
QWEN_TOKEN=

# Host/container port for the OpenAI-compatible API.
PORT=8080

# Host port for the dev compose stack (docker/docker-compose.yml).
DEV_PORT=8080

# --- Model source --------------------------------------------------------
# local (default): our in-house "262K-Balanced" GGUF (Phase 2/4), produced by
#   scripts/quantize.sh, mounted from the qwen38-models volume.
# hf: pull a public GGUF from Hugging Face via -hf/-hff for bring-up/smoke-tests.
MODEL_SOURCE=local
GGUF_FILE=qwen38-27b-heretic-ara-iq4_kss.gguf
HF_REPO=trohrbaugh/Qwen3.8-27B-heretic-ara
HF_FILE=

# Context window in tokens (200000 = 200k context window).
CTX=200000

# KV-cache data type for the full-attention layers
KV_TYPE=q4_0

# Hadamard-rotate the K/V cache before quantizing (reduces quantization error;
# Qwen3.6/3.8 attention head_dim=256 is power-of-2 compatible). Set 0 to disable.
KV_HADAMARD=1

# Prompt caching: context-checkpoint + prompt-state cache (full sequence-state save/restore).
# RAM budget in MiB (-1 = no limit, 0 = disable).
CACHE_RAM_MIB=8192
CTX_CHECKPOINTS=16

# Concurrent request slots. The server splits KV context evenly across slots.
N_PARALLEL=1

# Model-loading memory behavior (--no-mmap / --mlock).
DISABLE_MMAP=0
USE_MLOCK=0

# Physical batch size (-ub): raises prompt-processing throughput at the cost
# of VRAM for compute buffers; generation speed is unaffected.
# 1024 gives ~2x prompt tok/s speedup on RTX 3090.
BATCH_SIZE=4096
UBATCH_SIZE=1024

# Vision (multimodal). Qwen3.8-27B vision tower extracted from safetensors.
# Set 1 to serve image input with mmproj-BF16.gguf, or 0 for text-only.
ENABLE_VISION=1
MMPROJ_FILE=mmproj-BF16.gguf

# Jinja templating & tool calling engine
ENABLE_JINJA=1

# --- DFlash Speculative Decoding -----------------------------------------
ENABLE_DFLASH=0
DFLASH_REPO=z-lab/Qwen3.8-27B-DFlash2-GGUF
DFLASH_FILE=Qwen3.8-27B-DFlash2-iq4_kss.gguf
DFLASH_N_MAX=3
DFLASH_P_MIN=0.0

# --- MTP Speculative Decoding (Tuned for single 24GB RTX 3090) ---
ENABLE_MTP=1
SPEC_N=3
MTP_N_MAX=3
MTP_P_MIN=0.5
MTP_REQUANTIZE_OUTPUT_TYPE=q8_0

# Optional n-gram lookup drafter
ENABLE_NGRAM=1
NGRAM_TYPE=ngram-mod
NGRAM_N_MAX=16
NGRAM_N_MIN=2
NGRAM_SIZE_N=1024

# Reasoning routing (thinking gate)
REASONING=on
REASONING_FORMAT=deepseek

# Sampling defaults (clients can override per request).
TEMP=0.7
TOP_P=0.90
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.0

# Cap reasoning/thinking length; empty = unlimited.
REASONING_BUDGET=4086
REASONING_BUDGET_MESSAGE="... thinking budget exceeded, let's answer now."

# Preserve prior-turn <think> blocks when re-rendering the chat. Set 0 to strip.
PRESERVE_THINKING=1

# Optional prompt-cache slot directory (persist reusable KV slots to disk).
SLOT_SAVE_PATH=

# Space-separated extra llama-server flags for advanced tuning.
EXTRA_ARGS=

# --- Build-time (only used by `docker compose build`) ------------------------
# Fork/branch to compile, GPU arch (86 = RTX 3090).
LLAMA_REPO=https://github.com/ikawrakow/ik_llama.cpp.git
LLAMA_REF=main
CUDA_ARCH=86
CUDA_VERSION=13.3.0
