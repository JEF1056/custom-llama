{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@williamcr01/opencode-tps", "@opencode_weave/weave"],
  "model": "llama.cpp/qwen3.6-35b-a3b",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp Server",
      "options": {
        "baseURL": "http://localhost:{env:LLAMA_PORT}/v1",
        "apiKey": "{env:LLAMA_API_KEY}",
        "includeUsage": true
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6-35B-A3B",
          "limit": {
            "context": "{ini:qwen3.6-35b-a3b.ctx-size}",
            "output": 32000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "reasoning": true,
          "tool_call": true
        },
        "qwopus3.6-27b": {
          "name": "Qwen3.6-27B",
          "limit": {
            "context": "{ini:qwopus3.6-27b.ctx-size}",
            "output": 32000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "reasoning": true,
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "search tools": {
      "type": "remote",
      "url": "http://localhost:{env:MCP_SERVER_PORT}",
      "headers": {
        "Authorization": "Bearer {env:MCP_API_KEY}"
      },
      "enabled": true
    }
  },
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "permission": {
    "bash": {
      "*": "allow"
    },
    "*": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
