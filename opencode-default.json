{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@williamcr01/opencode-tps", "github:JEF1056/harness#main"],
  "model": "llama.cpp/qwopus3.6-27b",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp Server",
      "options": {
        "baseURL": "https://chat.jessfan.com/v1",
        "apiKey": "{env:LLAMA_API_KEY}",
        "includeUsage": true,
        "headers": {
          "CF-Access-Client-Id": "{env:CF_ACCESS_CLIENT_ID}",
          "CF-Access-Client-Secret": "{env:CF_ACCESS_CLIENT_SECRET}"
        }
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6-35B-A3B",
          "limit": {
            "context": "{ctx:qwen3.6-35b-a3b}",
            "output": 32000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "reasoning": true,
          "tool_call": true
        },
        "qwopus3.6-27b": {
          "name": "qwopus3.6-27B",
          "limit": {
            "context": "{ctx:qwopus3.6-27b}",
            "output": 32000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "reasoning": true,
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "search tools": {
      "type": "remote",
      "url": "https://mcp.jessfan.com",
      "headers": {
        "Authorization": "Bearer {env:MCP_API_KEY}"
      },
      "enabled": true
    }
  },
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "permission": {
    "bash": {
      "*": "allow"
    },
    "*": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
