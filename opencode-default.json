{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@opencode_weave/weave"
  ],
  "model": "jessfan/qwen3.6-27b",
  "provider": {
    "jessfan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM Server",
      "options": {
        "baseURL": "http://localhost:{env:VLLM_PORT}/v1",
        "apiKey": "{env:VLLM_API_KEY}",
        "includeUsage": true
      },
      "models": {
        "qwen3.6-27b": {
          "name": "Qwen3.6-27B",
          "limit": {
            "context": 100000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": false,
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "search tools": {
      "type": "remote",
      "url": "http://localhost:{env:MCP_SERVER_PORT}/mcp",
      "headers": {
        "Authorization": "Bearer {env:MCP_API_KEY}"
      },
      "enabled": true
    }
  },
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "permission": {
    "bash": {
      "*": "allow"
    },
    "*": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
