# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# Firebase — copy from your Firebase console (same project as portfolio)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated Firebase UIDs allowed to access the chat UI.
# Get UIDs from: Firebase Console → Authentication → Users → UID column.
# Same var as portfolio's VITE_ADMIN_UID.
VITE_ADMIN_UID=
